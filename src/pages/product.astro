---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WorkedExample from '../components/WorkedExample.astro';
import DepthOfEvidence from '../components/DepthOfEvidence.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Workflow from '../components/Workflow.astro';
import Integrations from '../components/Integrations.astro';
import ResolvedExample from '../components/ResolvedExample.astro';
---

<BaseLayout
  title="Product"
  description="What Assay checks and how. The anatomy of an overfitted patch, built by us to show the shape, the four checks, the pull request status check, and what it plugs into."
  path="/product"
>
  <PageHeader
    eyebrow="Product"
    title="Independent verification for AI-authored code."
    lede="What an overfitted patch looks like, on a patch we built to show the shape, and the four checks that catch it."
  />

  <WorkedExample />
  <DepthOfEvidence />
  <HowItWorks />
  <Workflow />
  <Integrations />
  <ResolvedExample />
</BaseLayout>
