---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TermPanel from '../components/system/TermPanel.astro';
import CheckRow from '../components/system/CheckRow.astro';
import ReportRows from '../components/system/ReportRows.astro';
import type { ReportRow as Row } from '../components/system/ReportRows.astro';
import { SECURITY_ADVISORY_URL, METHOD_VERSION } from '../lib/site';

const checks = [
  'the reported hole is genuinely gone, not merely quiet',
  'the patch holds on cases written before the agent was invoked, and kept out of everything it could read',
  'nothing was broken, and nothing new was introduced',
  'the agent wrote what it meant to write, not what somebody planted in a file it read',
] as const;

// Every field that lets somebody make safety-critical changes separates the
// maker from the checker. One does not.
const fields: Row[] = [
  { k: 'Finance', v: 'the auditor did not prepare the accounts' },
  { k: 'Clinical trials', v: 'the reviewer is not the sponsor' },
  {
    k: 'AI security fixes',
    v: 'the checker is the fixer',
    t: 'the gap',
    mark: true,
  },
];

const terms = [
  {
    term: 'Authority',
    definition: 'a vendor telling you its patch worked. It is citing itself.',
  },
  {
    term: 'Evidence',
    definition:
      'a result somebody else produced, by a method you can read, on cases you can re-run.',
  },
] as const;

const commitments: Row[] = [
  { k: 'Harness', v: 'open source' },
  { k: 'Index corpus', v: 'published by identifier' },
  { k: 'Every verdict', v: 'ships the command that reproduces it' },
  { k: 'Methodology', v: 'spends as much room on where the method fails as on where it works' },
  {
    k: 'Bypasses',
    v: 'wanted. A patch we approve that does not fix the vulnerability is the most valuable bug in the product.',
  },
];

// The colophon. Every line is checkable in the repository: the two faces
// are the woff2 files in public/fonts, the method version is METHOD_VERSION,
// and the source is public. Nothing here is a claim about the company.
const colophon: Row[] = [
  { k: 'Display', v: 'JetBrains Mono' },
  { k: 'Text', v: 'Inter' },
  { k: 'Mono', v: 'JetBrains Mono' },
  { k: 'Method', v: `v${METHOD_VERSION}` },
  { k: 'Source', v: 'Static build, no tracking beyond page analytics' },
];

const status: Row[] = [
  { k: 'Customers', v: 'none yet' },
  { k: 'Logos', v: 'none' },
  { k: 'Index results', v: 'none. The first edition has not published.' },
];
---

<BaseLayout
  title="About"
  description="Assay is an independent check on AI-authored security fixes. What the company is for, where the credo comes from, and who is building it."
  path="/about"
>
  <PageHeader
    eyebrow="About"
    title="Nullius in verba."
    titleNote={`Take nobody’s word for it.`}
    lede="Assay exists to answer one question that currently has no impartial answer: when an AI writes a security fix, did the fix actually work? We do not write patches, we do not sell a scanner, and we do not intend to. The moment we do, our answer stops being worth anything."
  />

  <Section id="what-for" rule={false}>
    <Eyebrow class="reveal">What the company is for</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">One job, held deliberately narrow.</h2>

    {/* Four rows, and a fifth that is the one that matters: refused. */}
    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <TermPanel path="What we establish, on every AI-authored change">
        {checks.map((c, i) => <CheckRow id={String(i + 1).padStart(2, '0')} name={c} state="pending" status="" />)}
        <CheckRow id="05" name="Write the fix." state="fail" status="Refused" />
      </TermPanel>
    </div>

    <p class="reveal body mt-8" style="--reveal-delay:60ms;max-width:60ch">
      Independence is not a feature you add to a roadmap. It is a property of who is doing
      the looking.
    </p>

    <div class="reveal mt-12" style="--reveal-delay:60ms">
      <ReportRows text label="Who checks the work" rows={fields} />
    </div>

    <p class="reveal body mt-7 text-fg-2" style="--reveal-delay:60ms;max-width:62ch">
      Not because authors are dishonest. The assumptions that produced the work also
      produce the check on the work, and the blind spot is shared.
    </p>
  </Section>

  <Section id="credo" tint>
    <Eyebrow class="reveal">The credo</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Where the motto comes from.</h2>

    <p class="reveal body mt-8" style="--reveal-delay:120ms;max-width:66ch">
      The Royal Society took it in 1660, breaking with a tradition of settling questions by
      citing an authority.
    </p>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows label="Two ways to settle a question" text rows={terms.map((e) => ({ k: e.term, v: e.definition }))}>
        <Fragment slot="disc">The Society chose <b>evidence</b></Fragment>
      </ReportRows>
    </div>

    <div class="reveal mt-12" style="--reveal-delay:60ms">
      <ReportRows text label="Which is why" rows={commitments} />
    </div>

    <p class="reveal mt-7" style="--reveal-delay:60ms">
      <a href={SECURITY_ADVISORY_URL} rel="noopener" class="link-inline">
        Report a bypass via GitHub private vulnerability reporting
      </a>
    </p>

    <p class="statement reveal mt-11" style="--reveal-delay:60ms">
      Including ours. <span class="q">Especially ours.</span>
    </p>
  </Section>

  <Section id="who">
    <Eyebrow class="reveal">Who is building it</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Early, and saying so.</h2>

    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <ReportRows text label="Status" rows={status} />
    </div>

    <p class="reveal body mt-12" style="--reveal-delay:60ms;max-width:66ch">
      <span class="hd mb-4 block">Founder background</span>
      Application security, plus the automated program repair literature that named
      overfitting long before the current generation of tools existed, which is why this
      looked like a gap and not a novelty.
    </p>

    <p class="reveal body mt-8 text-fg-2" style="--reveal-delay:60ms;max-width:66ch">
      Vendors get their results and the underlying artifacts before anything publishes,
      with a window to respond. Responses go out unedited.
    </p>

    <div class="reveal mt-11 flex flex-wrap gap-3">
      <span class="btn btn-primary cursor-default" aria-disabled="true">Get in touch</span>
      <a href="/methodology" class="btn btn-secondary">Read the methodology</a>
    </div>

    {/* The colophon proper: how this was set, under the mark it was set by. */}
    <div class="reveal mt-16 border-t border-line pt-8">
      <p class="h2 mb-6">Nullius in verba</p>
      <ReportRows text label="Colophon" rows={colophon} />
    </div>
  </Section>
</BaseLayout>

