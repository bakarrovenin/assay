---
// A standalone document. This page deliberately does NOT use BaseLayout, the
// v2 token layer, global.css, or any site component, because none of them
// apply to it: no nav, no footer, no modal, no theme toggle, no dark theme,
// no section conventions. Everything it needs is in this file, so nothing
// leaks either way.
//
// Treatment is taken from inferact.ai, measured rather than guessed: a warm
// off-white ground, near black text, a humanist book face, section headings
// barely larger than the body and told apart by weight, paragraphs separated
// by space alone, and links underlined in the text colour.
//
// Copy is verbatim from assay-whitepaper-copy.md, minus the header block.
// Three protected lines run through it, so scripts/check-protected-copy.mjs
// covers this page.
import { site } from '../lib/site';

const title = 'Whitepaper · Assay';
const description =
  'Independent verification for AI authored code. The verification gap, the four checks, Pilot 001, and what the method caught in itself.';
const canonical = new URL('/whitepaper/', site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const EVIDENCE_REPO = 'https://github.com/bakarrovenin/assay-pilot-001-evidence';
const PILOT_POST = '/research/pilot-001-patches-against-unseen-attacks';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google Analytics 4 (gtag.js), the same tag the rest of the site carries. */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-BDC37TQ4BY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-BDC37TQ4BY');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Light in every context. This page has no dark treatment. */}
    <meta name="theme-color" content="#F7F6F3" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
