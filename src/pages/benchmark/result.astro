---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import TermPanel from '../../components/system/TermPanel.astro';
import CheckRow from '../../components/system/CheckRow.astro';
import VerdictLine from '../../components/system/VerdictLine.astro';
import ReportRows from '../../components/system/ReportRows.astro';

// The result lives in the URL fragment. This page is a static shell: the
// verdict blocks, the check table and the detail rows are rendered once at
// build time with placeholders, and the browser fills them from the decoded
// result. Nothing here is looked up anywhere.
const rows = [
  ['A alert', '…'],
  ['B attacks', '…'],
  ['C benign', '…'],
  ['D suppress', '…'],
  ['Class', '…'],
] as const;

const detail = [
  { k: 'Tool', v: '…' },
  { k: 'Version', v: '…' },
  { k: 'Finding', v: '…' },
  { k: 'Attacks succeeded', v: '…' },
  { k: 'Benign diverged', v: '…' },
  { k: 'Failure class', v: '…' },
  { k: 'Scored', v: '…' },
] as const;

const CHECKS = [
  ['A', 'Alert closed'],
  ['B', 'Hole shut'],
  ['C', 'Behaviour preserved'],
  ['D', 'Provenance clean'],
] as const;
---

<BaseLayout
  title="Result · Benchmark"
  description="A benchmark score with its verdict, check results and server record status."
  path="/benchmark/result"
>
  <div data-empty hidden>
    <Section density="hero" rule>
      <Eyebrow>No result in this link</Eyebrow>
      <h1 class="h1 mt-6">No benchmark result</h1>
      <p class="lede mt-8" style="max-width:62ch">
        The link carries no result, or one this page cannot read.
      </p>
      <p class="mt-6"><a href="/benchmark/" class="link-inline">Score a patch</a></p>
    </Section>
  </div>

  <div data-result hidden>
    <Section density="hero" rule>
      <Eyebrow>Benchmark · edition 1 · result</Eyebrow>
      <h1 class="h1 mt-6" data-headline>Benchmark result</h1>
      <p class="lede mt-8" style="max-width:62ch" data-summary>Four checks against your submitted patch.</p>
      <p class="note mt-5" data-record-status role="status" aria-live="polite">Checking the saved server record…</p>
    </Section>

  <Section id="verdict" rule={false} density="tight">
      {/* One panel for the three verdict shapes. The rows fill from the
          decoded result; the verdict line that shows is picked by data-vb. */}
      <div data-panel>
        <TermPanel path="assay · benchmark · result">
          {CHECKS.map(([k, name]) => <CheckRow id={k} name={name} state="pending" data-check={k} />)}

          <div class="ln out mt-4" data-rows>
            {rows.map(([k, v]) => (
              <div class="ln out"><span class="cmt">{k}</span> <span data-row={k}>{v}</span></div>
            ))}
          </div>
          <div class="ln out mt-4" data-rows-insufficient hidden>
            <div class="ln out"><span class="cmt">Reason</span> <span data-reason></span></div>
          </div>

          <div data-vb="verified" hidden>
            <VerdictLine label="Verified" tone="pass">all four recorded checks passed</VerdictLine>
          </div>
          <div data-vb="failed" hidden>
            <VerdictLine label="Not verified" tone="fail">one or more recorded checks failed</VerdictLine>
          </div>
          <div data-vb="insufficient" hidden>
            <VerdictLine label="Insufficient evidence" tone="neutral">the scorer could not complete all checks</VerdictLine>
          </div>
          <div data-vb="no-alert" hidden>
            <VerdictLine label="No alert" tone="neutral">there was no finding to verify</VerdictLine>
          </div>
        </TermPanel>
      </div>

      <div class="mt-8" data-detail>
        <ReportRows label="The result · carried in this link" rows={detail} text />
      </div>

      <div class="mt-11 border-t border-line pt-6" style="max-width:80ch">
        <p class="hd mb-4">Share this result</p>
        <div class="flex flex-col gap-2.5 sm:flex-row">
          <input type="text" readonly data-share-url class="input flex-1" />
          <button type="button" class="btn btn-secondary shrink-0" data-copy-url>Copy link</button>
        </div>
        <p class="note mt-4" style="max-width:70ch">
          When a submission ID is present, this page checks the score and checks against
          the saved server record. An incomplete-run diagnostic may only be in the link.
        </p>
      </div>

      <section class="mt-11 border-t border-line pt-6" style="max-width:80ch" data-feedback hidden>
        <h2 class="hd mb-4">Was this score useful?</h2>
        <form data-feedback-form>
          <fieldset class="flex flex-wrap gap-x-6 gap-y-3">
            <legend class="sr-only">Rate this score</legend>
            <label class="inline-flex items-center gap-2"><input type="radio" name="rating" value="useful" required /> Yes</label>
            <label class="inline-flex items-center gap-2"><input type="radio" name="rating" value="not_useful" required /> Not yet</label>
          </fieldset>
          <label class="block mt-5" for="score-feedback-message">
            <span class="note block mb-2">Anything we should know? (optional)</span>
            <textarea id="score-feedback-message" name="message" maxlength="1000" rows="3" class="input w-full" placeholder="Tell us what worked or what was missing."></textarea>
          </label>
          <button type="submit" class="btn btn-secondary mt-4">Send feedback</button>
          <p class="note mt-3" style="max-width:70ch">Your rating and comment are saved with this result. Patch text is not saved. Please do not include secrets or personal information.</p>
          <p class="note mt-3" data-feedback-status role="status" aria-live="polite"></p>
        </form>
      </section>

      <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/benchmark/" class="link-inline">Score another</a>
        <a href="/benchmark/leaderboard/" class="link-inline">Results by tool</a>
      </p>
    </Section>
  </div>
</BaseLayout>

<script>
  import { BENCHMARK_API, decodeResult, fetchStoredResult, findingById, submitFeedback, track } from '../../lib/benchmark';

  const r = decodeResult(window.location.hash);
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const box = document.querySelector<HTMLElement>('[data-result]')!;

  if (!r) {
    empty.hidden = false;
  } else {
    box.hidden = false;
    // Funnel: a verdict was received and rendered. Tool and verdict only.
    track('benchmark_verdict', { finding_id: r.finding, tool_name: r.tool, verdict: r.verdict });
    const f = findingById(r.finding);
    const c = r.checks;
    const submissionId = new URLSearchParams(window.location.search).get('submission');
    const recordStatus = document.querySelector<HTMLElement>('[data-record-status]')!;
    const feedbackSection = document.querySelector<HTMLElement>('[data-feedback]');
    const feedbackForm = document.querySelector<HTMLFormElement>('[data-feedback-form]');
    const feedbackStatus = document.querySelector<HTMLElement>('[data-feedback-status]');
    if (submissionId && BENCHMARK_API && feedbackSection && feedbackForm && feedbackStatus) {
      feedbackSection.hidden = false;
      feedbackForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submitButton = feedbackForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const rating = new FormData(feedbackForm).get('rating');
        const message = String(new FormData(feedbackForm).get('message') || '').trim();
        if (rating !== 'useful' && rating !== 'not_useful') return;
        if (submitButton) submitButton.disabled = true;
        feedbackStatus.textContent = 'Sending…';
        try {
          await submitFeedback({ result_id: submissionId, rating, message });
          feedbackForm.hidden = true;
          feedbackStatus.textContent = 'Thanks. Your feedback is saved with this score.';
        } catch (error) {
          feedbackStatus.textContent = error instanceof Error ? error.message : 'Could not send feedback. Try again.';
          if (submitButton) submitButton.disabled = false;
        }
      });
    }
    const pf = (ok: boolean) => (ok ? 'pass' : 'fail');

    const headline = document.querySelector<HTMLElement>('[data-headline]')!;
    const summary = document.querySelector<HTMLElement>('[data-summary]')!;
    if (r.verdict === 'VERIFIED') {
      headline.textContent = 'All four checks passed.';
      summary.textContent = 'The patch closed the alert, blocked the attacks, preserved valid behaviour, and used no suppression.';
    } else if (r.verdict === 'NOT VERIFIED') {
      headline.textContent = 'The patch did not pass.';
      summary.textContent = 'At least one benchmark check failed. The check results are below.';
    } else if (r.verdict === 'NO ALERT') {
      headline.textContent = 'No alert to verify.';
      summary.textContent = 'The scanner did not report the finding, so the patch could not be tested against it.';
    } else {
      headline.textContent = 'Insufficient evidence.';
      summary.textContent = 'The scorer could not complete the checks. See the diagnostic below.';
    }

    if (submissionId && BENCHMARK_API) {
      const canonical = (value: unknown): string => JSON.stringify(value, (_key, item) =>
        item && typeof item === 'object' && !Array.isArray(item)
          ? Object.fromEntries(Object.entries(item).sort(([left], [right]) => left.localeCompare(right)))
          : item,
      );
      void fetchStoredResult(submissionId).then((stored) => {
        if (!stored) {
          recordStatus.textContent = 'Could not check the server record. The result shown is carried in the link.';
          return;
        }
        const matches = stored && stored.finding === r.finding && stored.tool === r.tool &&
          stored.version === r.version && stored.date === r.date && stored.verdict === r.verdict &&
          stored.failureClass === r.failureClass && canonical(stored.checks) === canonical(r.checks);
        recordStatus.textContent = matches
          ? `Saved result · server record ${submissionId}${r.reason ? ' · diagnostic is link-carried' : ''}`
          : 'This link could not be matched to a saved server record.';
      });
    } else {
      recordStatus.textContent = 'Link-only result · no saved server record was checked.';
    }

    const which = r.verdict === 'VERIFIED' ? 'verified' : r.verdict === 'NOT VERIFIED' ? 'failed' : r.verdict === 'NO ALERT' ? 'no-alert' : 'insufficient';
    const vb = document.querySelector<HTMLElement>(`[data-vb="${which}"]`)!;
    vb.hidden = false;
    if (which === 'insufficient') {
      document.querySelector<HTMLElement>('[data-rows]')!.hidden = true;
      document.querySelector<HTMLElement>('[data-rows-insufficient]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-reason]')!.textContent = r.reason || 'The scorer did not provide a diagnostic.';
    }

    if (c) {
      const dds = document.querySelectorAll<HTMLElement>('[data-row]');
      const vals = [
        `${pf(c.A.pass)}, ${c.A.findingsAfter} finding${c.A.findingsAfter === 1 ? '' : 's'} after`,
        `${c.B.succeeded.length} of ${c.B.fired} succeeded${c.B.succeeded.length ? ': ' + c.B.succeeded.map((a) => a.id).join(', ') : ''}`,
        `${c.C.regressed.length} of ${c.C.fired} diverged${c.C.regressed.length ? ': ' + c.C.regressed.join(', ') : ''}`,
        c.D.suppressionInEffect ? 'suppression in effect' : c.D.pass ? 'no marker, no effect' : 'marker present',
        r.failureClass ?? 'correct',
      ];
      dds.forEach((dd, i) => (dd.textContent = vals[i] ?? dd.textContent));

      for (const [k, ok] of [['A', c.A.pass], ['B', c.B.pass], ['C', c.C.pass], ['D', c.D.pass]] as const) {
        const row = document.querySelector<HTMLElement>(`[data-check="${k}"]`)!;
        row.classList.remove('is-pending');
        row.classList.add(ok ? 'is-pass' : 'is-fail');
        row.querySelector('.st')!.textContent = pf(ok).toUpperCase();
      }
    } else {
      for (const k of ['A', 'B', 'C', 'D']) {
        const row = document.querySelector<HTMLElement>(`[data-check="${k}"]`)!;
        row.querySelector('.st')!.textContent = 'not run';
      }
    }

    const byClass = (list: { id: string; class: string }[]) => {
      if (!list.length) return 'none';
      const m = new Map<string, string[]>();
      for (const a of list) (m.get(a.class) ?? m.set(a.class, []).get(a.class)!).push(a.id);
      return [...m.entries()].map(([cls, ids]) => `${cls}: ${ids.join(', ')}`).join(' · ');
    };

    const detailVals = [
      r.tool,
      r.version,
      f ? `${r.finding} · ${f.shape} · ${f.file}` : r.finding,
      c ? byClass(c.B.succeeded) : 'not run',
      c ? (c.C.regressed.length ? c.C.regressed.join(', ') : 'none') : 'not run',
      r.failureClass ?? (r.verdict === 'VERIFIED' ? 'correct' : 'none'),
      `${r.date} · ${r.scorer === 'stub' ? 'stub scorer, in the browser' : r.scorer} · edition 1`,
    ];
    document
      .querySelectorAll<HTMLElement>('[data-detail] .row .v')
      .forEach((dd, i) => (dd.textContent = detailVals[i] ?? dd.textContent));

    const url = window.location.href;
    const field = document.querySelector<HTMLInputElement>('[data-share-url]')!;
    field.value = url;
    document.querySelector<HTMLButtonElement>('[data-copy-url]')?.addEventListener('click', async () => {
      // Funnel: a result link was copied to share.
      track('benchmark_share_copy', { finding_id: r.finding, tool_name: r.tool });
      try {
        await navigator.clipboard.writeText(url);
        field.select();
      } catch {
        field.select();
      }
    });
  }
</script>
