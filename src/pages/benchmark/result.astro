---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import VerdictBlock from '../../components/VerdictBlock.astro';
import RuledRows from '../../components/RuledRows.astro';

// The result lives in the URL fragment. This page is a static shell: the
// verdict blocks, the check table and the detail rows are rendered once at
// build time with placeholders, and the browser fills them from the decoded
// result. Nothing here is looked up anywhere.
const rows = [
  ['A alert', '…'],
  ['B attacks', '…'],
  ['C benign', '…'],
  ['D suppress', '…'],
  ['Class', '…'],
] as const;

const detail = [
  { lead: 'Tool', body: '…' },
  { lead: 'Version', body: '…' },
  { lead: 'Finding', body: '…' },
  { lead: 'Attacks succeeded', body: '…' },
  { lead: 'Benign diverged', body: '…' },
  { lead: 'Failure class', body: '…' },
  { lead: 'Scored', body: '…' },
] as const;

const CHECKS = [
  ['A', 'Alert closed'],
  ['B', 'Hole shut'],
  ['C', 'Behaviour preserved'],
  ['D', 'Provenance clean'],
] as const;
---

<BaseLayout
  title="Result · Benchmark"
  description="A benchmark result: the tool, the version, the four checks and the verdict, carried in the link."
  path="/benchmark/result"
>
  <PageHeader
    eyebrow="Benchmark · edition 1 · result"
    title="Unverified."
    lede="A self-reported result, scored by the stub in the submitter's browser. This link carries everything it shows and nothing was looked up."
    subLede="Runs we conducted are a separate set and never appear on this page."
  />

  <Section id="verdict" rule={false}>
    <div data-empty class="reveal" hidden>
      <Eyebrow>No result in this link</Eyebrow>
      <p class="mt-6 text-[17px] leading-[1.62]" style="max-width:62ch">
        The link carries no result, or one this page cannot read.
      </p>
      <p class="mt-6">
        <a href="/benchmark/" class="link-inline text-[15px] font-medium">Score a patch</a>
      </p>
    </div>

    <div data-result hidden>
      <Eyebrow class="reveal">Verdict</Eyebrow>
      <h2 class="h2 reveal" style="--reveal-delay:60ms" data-headline>&nbsp;</h2>

      <div class="mt-11 max-w-[80ch]" data-vb="verified" hidden>
        <VerdictBlock verdict="Verified" state="verified" rows={rows} />
      </div>
      <div class="mt-11 max-w-[80ch]" data-vb="failed" hidden>
        <VerdictBlock verdict="Not verified" state="failed" rows={rows} />
      </div>
      <div class="mt-11 max-w-[80ch]" data-vb="insufficient" hidden>
        <VerdictBlock
          verdict="Insufficient evidence"
          state="failed"
          rows={[['Reason', 'the patch did not change the module, so nothing about the vulnerability was tested']]}
        />
      </div>

      <div class="my-9 max-w-[80ch] overflow-hidden rounded-[3px] border border-line bg-bg lg:my-11">
        <table class="w-full min-w-[300px] border-collapse text-left">
          <caption class="sr-only">The four checks, pass or fail.</caption>
          <tbody>
            {
              CHECKS.map(([k, name], i) => (
                <tr class={i % 2 === 1 ? 'bg-bg-2' : ''}>
                  <th scope="row" class="mono whitespace-nowrap px-3 py-3 text-[13px] font-medium sm:px-4">
                    {k} · {name}
                  </th>
                  <td class="mono px-3 py-3 text-right text-[13px] sm:px-4" data-check={k}>
                    &hellip;
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mono border-t border-line px-3 py-3 text-[11px] leading-relaxed text-fg-2 sm:px-4">
          UNVERIFIED · self-reported · scored by the stub, not the harness
        </p>
      </div>

      <div class="max-w-[80ch]" data-detail>
        <RuledRows label="The result · carried in this link" rows={detail} />
      </div>

      <div class="mt-11 max-w-[80ch] border-t border-line pt-6">
        <p class="micro mb-3">Share this result</p>
        <div class="flex flex-col gap-2.5 sm:flex-row">
          <input
            type="text"
            readonly
            data-share-url
            class="mono min-w-0 flex-1 rounded-[3px] border border-line bg-bg px-3.5 py-3 text-[12px] text-fg"
          />
          <button type="button" class="btn btn-secondary shrink-0" data-copy-url>Copy link</button>
        </div>
        <p class="mono mt-3 text-[11px] leading-relaxed text-fg-2" style="max-width:70ch">
          The link is the result: tool, version, finding, four checks and verdict, encoded
          whole. Anyone opening it sees exactly this page, marked UNVERIFIED.
        </p>
      </div>

      <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/benchmark/" class="link-inline text-[15px] font-medium">Score another</a>
        <a href="/benchmark/leaderboard/" class="link-inline text-[15px] font-medium">Results by tool</a>
      </p>
    </div>
  </Section>
</BaseLayout>

<script>
  import { decodeResult, findingById, track } from '../../lib/benchmark';

  const r = decodeResult(window.location.hash);
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const box = document.querySelector<HTMLElement>('[data-result]')!;

  if (!r) {
    empty.hidden = false;
  } else {
    box.hidden = false;
    // Funnel: a verdict was received and rendered. Tool and verdict only.
    track('benchmark_verdict', { finding_id: r.finding, tool_name: r.tool, verdict: r.verdict });
    const f = findingById(r.finding);
    const c = r.checks;
    const pf = (ok: boolean) => (ok ? 'pass' : 'fail');

    const headline = document.querySelector<HTMLElement>('[data-headline]')!;
    headline.textContent =
      r.verdict === 'VERIFIED'
        ? 'The four checks hold.'
        : r.verdict === 'NOT VERIFIED'
          ? 'The alert is one thing. The hole is another.'
          : 'Nothing was tested.';

    const which = r.verdict === 'VERIFIED' ? 'verified' : r.verdict === 'NOT VERIFIED' ? 'failed' : 'insufficient';
    const vb = document.querySelector<HTMLElement>(`[data-vb="${which}"]`)!;
    vb.hidden = false;

    if (c) {
      const dds = vb.querySelectorAll('dd');
      const vals = [
        `${pf(c.A.pass)}, ${c.A.findingsAfter} finding${c.A.findingsAfter === 1 ? '' : 's'} after`,
        `${c.B.succeeded.length} of ${c.B.fired} succeeded${c.B.succeeded.length ? ': ' + c.B.succeeded.map((a) => a.id).join(', ') : ''}`,
        `${c.C.regressed.length} of ${c.C.fired} diverged${c.C.regressed.length ? ': ' + c.C.regressed.join(', ') : ''}`,
        c.D.suppressionInEffect ? 'suppression in effect' : c.D.pass ? 'no marker, no effect' : 'marker present',
        r.failureClass ?? 'correct',
      ];
      dds.forEach((dd, i) => (dd.textContent = vals[i] ?? dd.textContent));

      for (const [k, ok] of [['A', c.A.pass], ['B', c.B.pass], ['C', c.C.pass], ['D', c.D.pass]] as const) {
        const cell = document.querySelector<HTMLElement>(`[data-check="${k}"]`)!;
        cell.textContent = pf(ok);
        cell.classList.add(ok ? 'text-accent' : 'text-fail');
      }
    } else {
      for (const k of ['A', 'B', 'C', 'D']) {
        const cell = document.querySelector<HTMLElement>(`[data-check="${k}"]`)!;
        cell.textContent = 'not run';
        cell.classList.add('text-fg-3');
      }
    }

    const byClass = (list: { id: string; class: string }[]) => {
      if (!list.length) return 'none';
      const m = new Map<string, string[]>();
      for (const a of list) (m.get(a.class) ?? m.set(a.class, []).get(a.class)!).push(a.id);
      return [...m.entries()].map(([cls, ids]) => `${cls}: ${ids.join(', ')}`).join(' · ');
    };

    const detailVals = [
      r.tool,
      r.version,
      f ? `${r.finding} · ${f.shape} · ${f.file}` : r.finding,
      c ? byClass(c.B.succeeded) : 'not run',
      c ? (c.C.regressed.length ? c.C.regressed.join(', ') : 'none') : 'not run',
      r.failureClass ?? (r.verdict === 'VERIFIED' ? 'correct' : 'none'),
      `${r.date} · ${r.scorer === 'stub' ? 'stub scorer, in the browser' : r.scorer} · edition 1`,
    ];
    document
      .querySelectorAll<HTMLElement>('[data-detail] dd')
      .forEach((dd, i) => (dd.textContent = detailVals[i] ?? dd.textContent));

    const url = window.location.href;
    const field = document.querySelector<HTMLInputElement>('[data-share-url]')!;
    field.value = url;
    document.querySelector<HTMLButtonElement>('[data-copy-url]')?.addEventListener('click', async () => {
      // Funnel: a result link was copied to share.
      track('benchmark_share_copy', { finding_id: r.finding, tool_name: r.tool });
      try {
        await navigator.clipboard.writeText(url);
        field.select();
      } catch {
        field.select();
      }
    });
  }
</script>
