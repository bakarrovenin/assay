---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Table from '../../components/system/Table.astro';
import VerdictBadge from '../../components/system/VerdictBadge.astro';
import { ASSAY_RUNS, ASSAY_SOURCE, FINDINGS, aggregate, byTool, fmtRate } from '../../lib/benchmark';

// Runs we conducted, recounted at build time from the stored records. The
// submitted set is recounted in the browser from this browser's storage and
// rendered into the second sheet by the script below, with the same function.
const ours = byTool(ASSAY_RUNS);
const oursAll = aggregate(ASSAY_RUNS);

const COLS = [
  { label: 'Tool' },
  { label: 'Version' },
  { label: 'Cells', num: true },
  { label: 'Alert closed', num: true },
  { label: 'Verified', num: true },
  { label: 'Gap', num: true },
] as const;

const cellById = (toolKey: string, id: string) =>
  ASSAY_RUNS.find((r) => r.toolKey === toolKey && r.finding === id);
const toolKeys = [...new Set(ASSAY_RUNS.map((r) => r.toolKey!))];
const toolName = (k: string) => ASSAY_RUNS.find((r) => r.toolKey === k)!.tool;
---

<BaseLayout
  title="Leaderboard · Benchmark"
  description="Benchmark results by tool and version: alert closed against verified, with the cell count beside every rate. Runs we conducted and self-reported submissions are shown separately."
  path="/benchmark/leaderboard"
>
  <PageHeader
    eyebrow="Benchmark · edition 1 · results"
    title="By tool and version."
    lede="Alert closed against verified. The cell count sits beside every rate, so three cells never read like thirty."
    subLede="Two sets, never merged. Runs we conducted are the first sheet. Everything self-reported is the second, and is UNVERIFIED."
  />

  <Section id="assay" rule={false}>
    <Eyebrow class="reveal">Runs we conducted</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Pilot 001, blind run.</h2>

    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <Table columns={COLS} caption="Runs conducted by Assay, by tool and version, with cell counts.">
        {
          ours.map((row) => (
            <tr>
              <th scope="row">{row.tool}</th>
              <td>{row.version}</td>
              <td class="num">
                {row.tally.scored}
                {row.tally.noAlert ? ` + ${row.tally.noAlert} no alert` : ''}
              </td>
              <td class="num">{fmtRate(row.tally.alertClosedRate, row.tally.alertClosed, row.tally.scored)}</td>
              <td class="num is-pass">{fmtRate(row.tally.verifiedRate, row.tally.verified, row.tally.scored)}</td>
              <td class={`num ${row.tally.gapPp ? 'is-fail' : ''}`}>
                {row.tally.gapPp === null ? 'no cells' : `${row.tally.gapPp} pp`}
              </td>
            </tr>
          ))
        }
        <Fragment slot="foot">
          {oursAll.scored} scored cells across {ours.length} tools · alert closed {oursAll.alertClosed} of{' '}
          {oursAll.scored} · verified {oursAll.verified} of {oursAll.scored} · {oursAll.noAlert} no alert, counted
          in no rate · source {ASSAY_SOURCE.run}, commit {ASSAY_SOURCE.commit}
        </Fragment>
      </Table>
    </div>

    {/* Verdict per finding, so the rates above can be recounted by eye. */}
    <div class="reveal mt-10" style="--reveal-delay:180ms">
      <Table
        columns={[{ label: 'Finding' }, ...toolKeys.map((k) => ({ label: toolName(k) }))]}
        caption="Verdict per tool per finding for the runs Assay conducted."
        foot="Each cell is one evidence file in the pilot repository. The rates above are counted from these cells."
        minWidth={560}
      >
        {
          FINDINGS.map((f) => (
            <tr>
              <th scope="row">
                {f.shape} <span class="is-dim">{f.id}</span>
              </th>
              {toolKeys.map((k) => {
                const cell = cellById(k, f.id);
                const text = cell ? cell.verdict : 'not supplied';
                const label = text === 'NO ALERT' ? 'no alert raised' : text;
                const tone =
                  text === 'VERIFIED' ? 'pass' : text === 'NOT VERIFIED' ? 'fail' : text === 'NO ALERT' ? 'amber' : null;
                return (
                  <td>{tone ? <VerdictBadge label={label} tone={tone} /> : <span class="is-dim">{label}</span>}</td>
                );
              })}
            </tr>
          ))
        }
      </Table>
    </div>
  </Section>

  <Section id="submitted" tint>
    <Eyebrow class="reveal">Submitted</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Self-reported. Unverified.</h2>

    <p class="reveal body mt-8 text-fg-2" style="--reveal-delay:120ms;max-width:66ch">
      Scored by the stub in the submitter's browser, on trust, and in this pass stored in
      this browser only. These never merge with the sheet above.
    </p>

    <div class="reveal mt-10" style="--reveal-delay:180ms">
      <Table columns={COLS} caption="Self-reported submissions by tool and version, unverified." data-submitted-rows>
        <tr>
          <td colspan="6" class="is-dim" data-submitted-empty>No submissions stored in this browser yet.</td>
        </tr>
        <Fragment slot="foot"><span data-submitted-foot>UNVERIFIED · 0 scored cells</span></Fragment>
      </Table>
    </div>

    <p class="reveal mt-6">
      <a href="/benchmark/" class="link-inline">Score a patch</a>
    </p>

    {/* The corpus rotates each edition; this is the moment to catch someone who
        cares about the results. benchmark-waitlist, same segment as the rest. */}
    <div class="reveal mt-12 border-t border-line pt-6" style="max-width:70ch">
      <p class="hd mb-4">Next edition</p>
      <p class="body text-fg-2">
        The corpus rotates each edition so a published benchmark cannot be tuned against.{' '}
        <button
          type="button"
          class="link-inline"
          data-verify-cta
          data-verify-group="benchmark-waitlist"
          data-verify-title="Get the next edition"
          data-verify-lede="The benchmark corpus rotates each edition. Leave an address and we will send you the next one when it publishes."
        >Send me the next edition when it publishes.</button>
      </p>
    </div>
  </Section>
</BaseLayout>

<script>
  import type { ToolRow } from '../../lib/benchmark';
  import { byTool, fmtRate, fetchLeaderboard, loadSubmitted } from '../../lib/benchmark';

  const body = document.querySelector<HTMLElement>('[data-submitted-rows]')!;
  const foot = document.querySelector<HTMLElement>('[data-submitted-foot]')!;

  // Server-side leaderboard, so it is real rather than per browser. If the
  // service is unreachable, fall back to this browser's own submissions.
  const server = await fetchLeaderboard();
  const rows: ToolRow[] = server ? server.rows : byTool(loadSubmitted());
  const sum = (k: 'scored' | 'alertClosed' | 'verified') =>
    rows.reduce((n, r) => n + (r.tally[k] || 0), 0);
  const all = { scored: sum('scored'), alertClosed: sum('alertClosed'), verified: sum('verified') };

  if (rows.length) {
    body.replaceChildren(
      ...rows.map((row) => {
        const tr = document.createElement('tr');
        const cells: [string, string][] = [
          ['', row.tool],
          ['', row.version],
          ['num', String(row.tally.scored)],
          ['num', fmtRate(row.tally.alertClosedRate, row.tally.alertClosed, row.tally.scored)],
          ['num is-pass', fmtRate(row.tally.verifiedRate, row.tally.verified, row.tally.scored)],
          [`num ${row.tally.gapPp ? 'is-fail' : ''}`, row.tally.gapPp === null ? 'no cells' : `${row.tally.gapPp} pp`],
        ];
        cells.forEach(([cls, text], j) => {
          const el = document.createElement(j === 0 ? 'th' : 'td');
          if (j === 0) el.setAttribute('scope', 'row');
          el.className = cls;
          el.textContent = text;
          tr.appendChild(el);
        });
        return tr;
      }),
    );
  }
  foot.textContent = `UNVERIFIED · ${all.scored} scored cells across ${rows.length} tool${rows.length === 1 ? '' : 's'} · alert closed ${all.alertClosed} of ${all.scored} · verified ${all.verified} of ${all.scored}`;
</script>
