---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ReportRows from '../../components/system/ReportRows.astro';
import { ASSAY_RUNS, ASSAY_SOURCE, FINDINGS, aggregate } from '../../lib/benchmark';

// The headline is recounted at build time from the stored assay runs. The
// submitted set is recounted in the browser from what this browser stored.
// Neither number is written by hand anywhere.
const ours = aggregate(ASSAY_RUNS);

const isNot = [
  {
    k: 'What it does',
    v:
      'Scores a patch against four SQL injection shapes on a corpus we seeded, with the four checks the pilot runs: alert closed, hole shut, behaviour preserved, provenance clean.',
  },
  {
    k: 'What it does not do',
    v:
      'It does not scan your code, and it does not verify a fix on anyone’s real codebase. Every result is about our corpus and nothing else.',
  },
] as const;

const policy = [
  {
    k: 'Public corpus',
    v: 'The modules are published now. The edition-1 attack set is published with the live scorer, by id, class and payload; until then the attacks appear by id and class only. A fixer can be tuned against a published set, which is a known property of any published benchmark.',
  },
  {
    k: 'Rotation',
    v: 'The corpus rotates each edition and the edition is stamped on every result. A score against a retired edition says so.',
  },
  {
    k: 'Not the Index',
    v: 'The Index runs on real projects with real historical vulnerabilities and its held-out attacks stay withheld. The benchmark is the opposite by design: seeded flaws, published attacks, self-service.',
    t: 'deliberate',
  },
  {
    k: 'Two sets, never merged',
    v: 'Runs we conducted and self-reported submissions are counted and shown separately. A submission is scored on trust and marked UNVERIFIED wherever it appears.',
  },
] as const;
---

<BaseLayout
  title="Benchmark"
  description="Score an AI fixer's patch against four SQL injection shapes on a corpus we seeded. Public corpus, rotating editions, every result recountable."
  path="/benchmark"
>
  <PageHeader
    eyebrow="Benchmark · edition 1"
    title="Score a patch."
    lede="Four SQL injection shapes on a corpus we seeded. Give the module to any fixer, paste the patch back, get the four checks."
    subLede="The corpus and the attacks are public for this benchmark, which is the opposite of the Index. The page below says why."
  />

  <Section id="tally" rule={false}>
    <Eyebrow class="reveal">The running count</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Every fix shut the hole. Not every fix left the product working.</h2>

    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <ReportRows
        lead
        label="Runs we conducted · Pilot 001 blind run · recounted from the stored results at build time"
        rows={[
          { k: 'patches scored.', v: String(ours.scored) },
          {
            k: 'shut the hole. Every held-out attack blocked, no fixer left it open.',
            v: `${ours.holeShut} of ${ours.scored}`,
            tone: 'pass',
          },
          {
            k: `left the product working. The other ${ours.brokeBehaviour} closed the hole and rejected a legitimate input.`,
            v: `${ours.behaviourHeld} of ${ours.scored}`,
            tone: 'fail',
          },
        ]}
      >
        <Fragment slot="disc">
          Alert closed then verified, and the gap between &middot;{' '}
          <b>{ours.gapPp === null ? 'no cells' : `${ours.alertClosed} of ${ours.scored} to ${ours.verified} of ${ours.scored}, ${ours.gapPp} pp`}</b>
        </Fragment>
      </ReportRows>
    </div>

    <div class="reveal mt-10" style="--reveal-delay:180ms" data-submitted-tally>
      <ReportRows
        lead
        label="Submitted · UNVERIFIED · self-reported, scored by the stub, stored in this browser only"
        rows={[
          { k: 'patches scored.', v: '0' },
          { k: 'shut the hole.', v: 'none' },
          { k: 'left the product working.', v: 'none' },
        ]}
      >
        <Fragment slot="disc">
          Alert closed then verified, and the gap between &middot; <b>no cells</b>
        </Fragment>
      </ReportRows>
    </div>

    <p class="note reveal mt-6" style="max-width:76ch">
      {ours.noAlert} run(s) where the scanner raised no alert are counted in no rate. Every
      figure above is a recount of the stored records, not a stored number. Source:{' '}
      {ASSAY_SOURCE.run}, commit {ASSAY_SOURCE.commit}.
    </p>
  </Section>

  <Section id="what" tint>
    <Eyebrow class="reveal">What this is</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">An instrument, not a scanner.</h2>

    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <ReportRows label="Scope" rows={isNot} text />
    </div>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows label="Policy · stated before anyone asks" rows={policy} text />
    </div>
  </Section>

  <Section id="findings">
    <Eyebrow class="reveal">Pick a finding</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Four shapes.</h2>

    {/* Report rows, each row a link. The value keeps its three lines (shape,
        body, counts), which the ReportRows string value cannot carry. */}
    <div class="reveal rows is-text mt-10" style="--reveal-delay:120ms">
      {
        FINDINGS.map((f) => (
          <a href={`/benchmark/${f.id}/`} class="row">
            <span class="k">
              <span class="block whitespace-nowrap">Finding {f.id}</span>
              <span class="block normal-case tracking-normal">{f.file}</span>
            </span>
            <span class="v">
              <span class="block font-bold text-fg">{f.shape}</span>
              <span class="mt-1 block text-fg-2">{f.body}</span>
              <span class="disc mt-2 block">
                {f.attacks.length} held-out attacks · {f.benign.length} benign inputs
              </span>
            </span>
            <span class="t">Open &rarr;</span>
          </a>
        ))
      }
    </div>

    <p class="reveal mt-10">
      <a href="/benchmark/leaderboard/" class="link-inline">Results by tool and version</a>
    </p>

    {/* The product waitlist (verify-pr), kept distinct from the benchmark
        waitlist on the finding and leaderboard pages: this is the verifier on
        your own repositories, not the self-service corpus. */}
    <div class="reveal mt-12 border-t border-line pt-6" style="max-width:70ch">
      <p class="hd mb-4">The product</p>
      <p class="body text-fg-2">
        This benchmark is a fixed corpus you score against by hand. The verifier it comes from
        runs the same four checks on every pull request, on your own repositories.{' '}
        <button
          type="button"
          class="link-inline"
          data-verify-cta
          data-verify-group="verify-pr"
          data-verify-title="Join the product waitlist"
          data-verify-lede="A verifier that runs the four checks on every pull request, on your own repositories, is in development. Leave an address and we will tell you when it is ready."
        >Join the product waitlist.</button>
      </p>
    </div>
  </Section>
</BaseLayout>

<script>
  import { aggregate, fetchLeaderboard, loadSubmitted, track } from '../../lib/benchmark';

  // Funnel: someone reached the benchmark entry.
  track('benchmark_view');

  // The submitted count comes from the server so it is real across everyone,
  // not just this browser. If the service is unreachable, fall back to this
  // browser's own runs. The rate is a recount either way.
  const box = document.querySelector<HTMLElement>('[data-submitted-tally]');
  if (box) {
    const server = await fetchLeaderboard();
    let t;
    if (server) {
      const sum = (k: 'scored' | 'alertClosed' | 'verified') =>
        server.rows.reduce((n, r) => n + (r.tally[k] || 0), 0);
      const scored = sum('scored');
      const pct = (n: number) => (scored === 0 ? null : Math.round((n / scored) * 100));
      t = {
        scored,
        alertClosed: sum('alertClosed'),
        verified: sum('verified'),
        alertClosedRate: pct(sum('alertClosed')),
        verifiedRate: pct(sum('verified')),
        gapPp:
          pct(sum('alertClosed')) === null || pct(sum('verified')) === null
            ? null
            : (pct(sum('alertClosed')) as number) - (pct(sum('verified')) as number),
      };
    } else {
      t = aggregate(loadSubmitted());
    }
    const vs = box.querySelectorAll('.row .v');
    const ks = box.querySelectorAll('.row .k');
    const foot = box.querySelector('.disc b');
    const rate = (r: number | null) => (r === null ? 'none' : `${r}%`);
    if (vs.length === 3 && ks.length === 3) {
      vs[0].textContent = String(t.scored);
      ks[0].textContent = 'patches scored.';
      vs[1].textContent = rate(t.alertClosedRate);
      ks[1].textContent = `closed the alert. ${t.alertClosed} of ${t.scored}.`;
      vs[2].textContent = rate(t.verifiedRate);
      ks[2].textContent = `actually verified. ${t.verified} of ${t.scored}.`;
    }
    if (foot) foot.textContent = t.gapPp === null ? 'no cells' : `${t.gapPp} pp`;
  }
</script>
