---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import TermPanel from '../../components/system/TermPanel.astro';
import ReportRows from '../../components/system/ReportRows.astro';
import { FINDINGS, findingById, SCORING_LIVE } from '../../lib/benchmark';
import { highlightPython } from '../../lib/highlight';

import corpus01 from '../../data/benchmark/corpus/finding_b01.py?raw';
import corpus04 from '../../data/benchmark/corpus/finding_b04.py?raw';
import corpus08 from '../../data/benchmark/corpus/finding_b08.py?raw';
import corpus13 from '../../data/benchmark/corpus/finding_b13.py?raw';

export function getStaticPaths() {
  return FINDINGS.map((f) => ({ params: { finding: f.id } }));
}

const SOURCES: Record<string, string> = {
  '01': corpus01,
  '04': corpus04,
  '08': corpus08,
  '13': corpus13,
};

const { finding: id } = Astro.params;
const finding = findingById(id!)!;
const source = SOURCES[finding.id];
const html = highlightPython(source);

// Attacks by class, ids only. The payloads are not on this page.
const classes = [...new Set(finding.attacks.map((a) => a.class))];
const attackRows = classes.map((c) => ({
  k: c,
  v: finding.attacks.filter((a) => a.class === c).map((a) => a.id).join(', '),
}));

const steps = [
  'Copy the module and give it to the fixer with the prompt line, exactly as written, and nothing else.',
  'Paste the patch it returns below, as a unified diff or as the whole patched file.',
  'Name the tool and its version. That is what makes the result citable.',
] as const;
---

<BaseLayout
  title={`Finding ${finding.id} · ${finding.shape} · Benchmark`}
  description={`${finding.shape}: ${finding.body} Score a fixer's patch against it.`}
  path={`/benchmark/${finding.id}`}
>
  <PageHeader
    eyebrow={`Benchmark · edition 1 · finding ${finding.id}`}
    title={finding.shape}
    lede={finding.body}
    subLede={`${finding.file} · ${finding.attacks.length} held-out attacks · ${finding.benign.length} benign inputs`}
  />

  <Section id="submit" rule={false}>
    <Eyebrow class="reveal">Paste the patch back</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">Score it.</h2>

    <p class="reveal body mt-8 text-fg-2" style="--reveal-delay:90ms;max-width:66ch">
      First time here? Hand the module and prompt below to any fixer, then paste the patch it
      returns to score it against the held-out attacks.
    </p>

    <form class="reveal mt-9 max-w-[80ch]" data-submit style="--reveal-delay:120ms" novalidate>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="tool" class="hd label">Tool</label>
          <input
            id="tool"
            name="tool"
            type="text"
            required
            autocomplete="off"
            placeholder="e.g. Claude Code"
            class="input"
          />
        </div>
        <div>
          <label for="version" class="hd label">Version</label>
          <input
            id="version"
            name="version"
            type="text"
            required
            autocomplete="off"
            placeholder="e.g. 2.1.270, Opus 5"
            class="input"
          />
        </div>
      </div>

      <div class="mt-5">
        <label for="patch" class="hd label">
          Patch · unified diff or the whole patched file
        </label>
        <textarea
          id="patch"
          name="patch"
          required
          rows="14"
          spellcheck="false"
          class="input"
          placeholder="--- a/app/finding_04.py&#10;+++ b/app/finding_04.py"></textarea>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button
          type={SCORING_LIVE ? 'submit' : 'button'}
          class={SCORING_LIVE ? 'btn btn-primary' : 'btn btn-secondary'}
          {...(SCORING_LIVE
            ? {}
            : {
                'data-notify': true,
                'data-verify-cta': true,
                'data-verify-group': 'benchmark-waitlist',
                'data-verify-title': 'Notify me when scoring opens',
                'data-verify-lede':
                  "Scoring is not live yet. The scorer that runs the four checks on your fixer's patch is coming online shortly. Leave an address and we will tell you the moment it is live.",
              })}
        >{SCORING_LIVE ? 'Score the patch' : 'Notify me when scoring opens'}</button>
        <span class="failr text-[13px] font-normal" data-error hidden></span>
      </div>

      {!SCORING_LIVE && (
        <p class="note mt-4" style="max-width:70ch">
          Scoring goes live shortly. Until then this button opens a notify signup instead of
          scoring, and we will tell you the moment you can score a patch here.
        </p>
      )}

      <p class="note mt-5" style="max-width:70ch">
        The patch is scored by the harness in a sealed container with no network egress, torn
        down after the run. Nothing from your patch is kept beyond the result.
      </p>
    </form>
  </Section>

  <Section id="module" tint>
    <Eyebrow class="reveal">The module</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">What the fixer gets.</h2>

    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <ReportRows label="Three steps" text narrow rows={steps.map((v, i) => ({ k: String(i + 1).padStart(2, '0'), v }))} />
    </div>

    <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--reveal-delay:180ms">
      <button type="button" class="btn btn-secondary btn-sm" data-copy="module">Copy module</button>
      <button type="button" class="btn btn-secondary btn-sm" data-copy="prompt">Copy prompt</button>
      <span class="cmt text-[13px]" data-copied hidden>copied</span>
    </div>

    {/* Highest-intent moment: right after they take the module to a fixer.
        benchmark-waitlist, same segment as the submit-step notify button. */}
    <p class="reveal note mt-5" style="--reveal-delay:220ms;max-width:70ch">
      Taking this to a fixer?{' '}
      <button
        type="button"
        class="link-inline"
        data-verify-cta
        data-verify-group="benchmark-waitlist"
        data-verify-title="Notify me when scoring opens"
        data-verify-lede="The scorer that runs the four checks on your fixer's patch is coming online shortly. Leave an address and we will tell you the moment it is live."
      >Get told when scoring opens</button>{' '}
      so you know to come back with the patch.
    </p>

    <div class="reveal mt-8" style="--reveal-delay:240ms">
      <TermPanel path="Prompt · the only line the fixer is given">
        <div class="ln cmd" set:html={finding.prompt.replace(/&/g, '&amp;').replace(/</g, '&lt;')} />
      </TermPanel>
    </div>

    <div class="reveal mt-6" style="--reveal-delay:300ms">
      <TermPanel path={`${finding.file} · unpatched`}>
        <pre class="term-block" set:html={html} />
      </TermPanel>
    </div>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows
        label={`Held-out attacks · by id and class · ${finding.attacks.length} fired after the patch`}
        rows={attackRows}
        text
      />
    </div>
  </Section>

  <script is:inline type="application/json" data-finding-source set:html={JSON.stringify({ id: finding.id, source })} />
</BaseLayout>

<script>
  import { findingById, resultUrl, saveSubmitted, submitScore, track, SCORING_LIVE } from '../../lib/benchmark';

  const data = JSON.parse(
    document.querySelector('[data-finding-source]')!.textContent || '{}',
  ) as { id: string; source: string };
  const finding = findingById(data.id)!;

  // Funnel: someone opened this finding.
  track('benchmark_finding_open', { finding_id: finding.id });

  // ---- copy buttons ----
  const copied = document.querySelector<HTMLElement>('[data-copied]');
  let timer: number | undefined;
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const which = btn.dataset.copy === 'module' ? 'module' : 'prompt';
      const text = which === 'module' ? data.source : finding.prompt;
      track(which === 'module' ? 'benchmark_copy_module' : 'benchmark_copy_prompt', {
        finding_id: finding.id,
      });
      try {
        await navigator.clipboard.writeText(text);
        if (copied) {
          copied.hidden = false;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => (copied.hidden = true), 1600);
        }
      } catch {
        /* clipboard blocked: the text is on the page to select */
      }
    });
  }

  // ---- score, or waitlist ----
  // THE SCORING SWITCH (lib/benchmark.ts SCORING_LIVE). While the scorer is not
  // deployed, the full form is shown but the button opens the waitlist and fires
  // its own benchmark_score_waitlist event, kept distinct from the real submit so
  // that once scoring is live a genuine benchmark_submit is never confused with a
  // not-live waitlist click. The real service wiring below is left intact and runs
  // the moment SCORING_LIVE is true; nothing else changes.
  if (SCORING_LIVE) {
    const form = document.querySelector<HTMLFormElement>('[data-submit]');
    const error = document.querySelector<HTMLElement>('[data-error]');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const tool = String(fd.get('tool') || '').trim();
      const version = String(fd.get('version') || '').trim();
      const patch = String(fd.get('patch') || '');
      const fail = (msg: string) => {
        if (error) {
          error.textContent = msg;
          error.hidden = false;
        }
      };
      if (!tool || !version || !patch.trim()) {
        fail('Tool, version and patch are all required. A result without a tool and version is not citable.');
        return;
      }
      if (error) error.hidden = true;
      // Funnel: a patch was submitted for scoring. Tool name only, never the patch.
      track('benchmark_submit', { finding_id: finding.id, tool_name: tool });
      const label = submitBtn?.textContent ?? 'Score the patch';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Scoring in a container, this takes a moment';
      }
      try {
        const { result } = await submitScore({ finding: finding.id, patch, tool, version });
        saveSubmitted(result);
        window.location.href = resultUrl(result, window.location.origin);
      } catch (err) {
        fail(err instanceof Error ? err.message : 'scoring failed, try again shortly');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = label;
        }
      }
    });
  } else {
    // Scoring not live: the full form is shown so a visitor sees the real tool,
    // but the submit button does not score. It carries the shared data-verify-cta
    // attributes (benchmark-waitlist userGroup), so EmailModal opens the waitlist
    // on click. Guard the form so Enter never triggers a native submit, and fire
    // benchmark_score_waitlist (its own event, never benchmark_submit) so a not-live
    // click stays distinguishable from a real submission once scoring is live.
    document
      .querySelector<HTMLFormElement>('[data-submit]')
      ?.addEventListener('submit', (e) => e.preventDefault());
    document
      .querySelector<HTMLButtonElement>('[data-notify]')
      ?.addEventListener('click', () => {
        track('benchmark_score_waitlist', { finding_id: finding.id });
      });
  }
</script>
