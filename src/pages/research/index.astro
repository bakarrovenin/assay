---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';

interface PostFrontmatter {
  title: string;
  description: string;
  date: string;
  author: string;
  readingTime: string;
}

interface PostModule {
  frontmatter: PostFrontmatter;
  url?: string;
}

interface AstroPostModule {
  frontmatter?: PostFrontmatter;
}

const mdModules = import.meta.glob<PostModule>('./*.md', { eager: true });

// Posts that need the artifact components (Diff, VerdictBlock, Terminal) are
// .astro pages rather than markdown, and export the same frontmatter shape.
// Astro supplies `url` for markdown only, so theirs comes from the file name.
const astroModules = import.meta.glob<AstroPostModule>(['./*.astro', '!./index.astro'], {
  eager: true,
});

const posts = [
  ...Object.values(mdModules)
    .filter((post) => Boolean(post.url))
    .map((post) => ({ url: post.url as string, frontmatter: post.frontmatter })),
  ...Object.entries(astroModules)
    .filter(([, mod]) => Boolean(mod.frontmatter))
    .map(([path, mod]) => ({
      url: `/research/${path.replace(/^\.\//, '').replace(/\.astro$/, '')}`,
      frontmatter: mod.frontmatter as PostFrontmatter,
    })),
].sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime(),
);

/** FILED 2026.09.08, the form section 4 asks for. */
const filed = (value: string) => new Date(value).toISOString().slice(0, 10).replace(/-/g, '.');

/** Issue number by publication order, oldest first. Posts are listed newest
 *  first, so the newest carries the highest number. */
const issueOf = (index: number) => String(posts.length - index).padStart(2, '0');
---

<BaseLayout
  title="Research"
  description="Writing on autonomous remediation governance, overfitted patches, and what independent verification of AI-authored code actually requires."
  path="/research/"
>
  <PageHeader
    eyebrow="Research"
    title="Notes on verifying what the machines did."
    lede="Working notes on autonomous remediation governance. Where held-out testing holds, where it does not, and what a record has to contain to be worth anything."
  />

  <Section id="posts" rule={false}>
    <ul class="max-w-[80ch]">
      {
        posts.map((post, i) => (
          <li class="reveal border-b border-line" style={`--reveal-delay:${i * 60}ms`}>
            <a href={post.url} class="group block py-8 lg:py-10">
              {/* Dispatch slug: issue number, filed date, extent. */}
              <p class="micro flex flex-wrap gap-x-4 gap-y-1">
                <span>Issue {issueOf(i)}</span>
                <span>
                  Filed{' '}
                  <time datetime={post.frontmatter.date}>{filed(post.frontmatter.date)}</time>
                </span>
                <span>{post.frontmatter.readingTime}</span>
              </p>

              <h2 class="mt-3.5 font-display text-[24px] font-bold leading-tight tracking-[-0.02em] transition-colors group-hover:text-accent lg:text-[30px]">
                {post.frontmatter.title}
              </h2>

              <p class="mt-3.5 max-w-[62ch] text-[15.5px] leading-[1.6] text-fg-2">
                {post.frontmatter.description}
              </p>

              <span class="mono mt-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.14em] text-fg-3">
                Read
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-1"
                >
                  <path
                    d="M4 12h15M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mono reveal mt-10 text-[11px] text-fg-2">
      More as the first edition of the Index comes together.
    </p>
  </Section>
</BaseLayout>
