---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import IndexTable from '../components/IndexTable.astro';
import IndexSignup from '../components/IndexSignup.astro';
import ReportRows from '../components/system/ReportRows.astro';
// Background, moved off the homepage in the engineer-audience restructure. The
// landscape and the borrowed third-party numbers are context for the
// measurement, not the argument, so they sit at the foot of the Index and never
// lead.
import EcosystemBar from '../components/EcosystemBar.astro';
import StructuralProblem from '../components/StructuralProblem.astro';
import VerificationGap from '../components/VerificationGap.astro';

// The research posts are the Index's working, so they are listed here and
// reached from here. Same glob as /research, which keeps its URL.
interface PostFrontmatter {
  title: string;
  description: string;
  date: string;
  readingTime: string;
}
const mdPosts = import.meta.glob<{ frontmatter: PostFrontmatter; url?: string }>(
  './research/*.md',
  { eager: true },
);
const astroPosts = import.meta.glob<{ frontmatter?: PostFrontmatter }>(
  ['./research/*.astro', '!./research/index.astro'],
  { eager: true },
);
const posts = [
  ...Object.values(mdPosts)
    .filter((post) => Boolean(post.url))
    .map((post) => ({ url: post.url as string, frontmatter: post.frontmatter })),
  ...Object.entries(astroPosts)
    .filter(([, mod]) => Boolean(mod.frontmatter))
    .map(([path, mod]) => ({
      url: `/research/${path.replace(/^\.\/research\//, '').replace(/\.astro$/, '')}`,
      frontmatter: mod.frontmatter as PostFrontmatter,
    })),
].sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime(),
);
const filed = (value: string) => new Date(value).toISOString().slice(0, 10).replace(/-/g, '.');
const issueOf = (index: number) => String(posts.length - index).padStart(2, '0');

const columns = [
  {
    name: 'Fixes tested',
    body:
      'How many findings the tool was given. Every tool gets the identical finding, in whatever format it natively consumes, at its documented defaults.',
  },
  {
    name: 'Alert closed',
    body:
      'How often the scanner went quiet afterwards. This is the number the industry currently reports, and it is the number every vendor can produce about itself.',
  },
  {
    name: 'Verified fix',
    body:
      'How often the vulnerability was actually gone, measured on cases the tool never saw. This is the number nobody publishes.',
  },
];

const conditions = [
  'the hole is closed on attacks the tool was never shown',
  'ordinary behaviour is unchanged',
  'no new problem was introduced',
  'nothing suggests the tool was manipulated into writing it',
] as const;

// Beneath the sheet: what the rows are and are not, and what has been
// measured so far. Both are choices, stated as such.
// The Pilot 001 blind run report is published; this points straight at it.
const PILOT_REPORT = '/research/pilot-001-blind-run';

const notes = [
  {
    k: 'Scope',
    v: 'The Index measures the tools developers actually use to fix a flagged vulnerability, which today are general coding assistants rather than dedicated remediation products. Dedicated remediation tools such as Snyk, Pixee, Mobb and ZeroPath are out of scope for this edition, not absent from the market.',
  },
  {
    k: 'Measured so far',
    v: 'Pilot 001\u2019s blind run put ChatGPT, Claude Code and Copilot Autofix through four SQL injection shapes. Pilot 001 is not the Index: the Index runs on real projects with real historical vulnerabilities, and the pilot runs on a corpus we seeded.',
    link: { href: PILOT_REPORT, label: 'Read the Pilot 001 report' },
  },
  {
    k: 'Try the checks',
    v: 'The benchmark runs the same four checks on a corpus we seeded, self-service, with the corpus and the attacks public and rotating each edition. It is the opposite of the Index by design and never feeds it.',
    link: { href: '/benchmark', label: 'Open the benchmark' },
  },
] as const;

const rules = [
  ['Corpus', 'Real vulnerabilities with known ground truth fixes, published by identifier so the selection can be audited.'],
  ['Equal treatment', 'No tool gets extra context, a tuned prompt, or a second attempt another did not get.'],
  ['No human editing', 'The proposed fix is captured exactly as produced. We do not repair a patch to flatter a tool.'],
  ['Held-out first', 'Cases are generated before any tool sees the finding, and are never published in a form that could be trained against.'],
  ['Right of reply', 'Every vendor sees its results before publication and its response is published unedited.'],
  ['We are not exempt', 'If Assay ever ships a fix generation product, it will not appear in the Index.'],
] as const;
---

<BaseLayout
  title="The Index"
  description="An independent, quarterly comparison of the coding assistants developers use to fix flagged vulnerabilities, run on the same harness, with the free DARPA systems as the baseline. First edition in progress."
  path="/the-index"
>
  <PageHeader
    eyebrow="The Index"
    title="Which AI fixers actually work?"
    lede="Every published number comes from the vendor that wrote the fix."
    subLede="Every cell below is empty, because the alternative is inventing numbers, which is the exact thing this Index exists to catch."
  />

  <Section id="results" rule={false}>
    <Eyebrow class="reveal">Results</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">First edition in progress.</h2>

    <div class="mt-10">
      <IndexTable />
    </div>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows text rows={notes} />
    </div>

    <div class="mt-10">
      <IndexSignup />
    </div>
  </Section>

  <Section id="what-verified-means" tint>
    <Eyebrow class="reveal">In plain English</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">What a verified fix means.</h2>

    <p class="reveal body mt-8" style="--reveal-delay:120ms;max-width:62ch">
      A scanner finds a hole. Something writes a patch. The scanner runs again and the
      warning is gone. Almost everyone stops there. The patch was written to make that
      warning go away.
    </p>

    {/* The argument, standing on its own rather than closing a paragraph. */}
    <p class="statement reveal mt-10" style="--reveal-delay:60ms">
      Re-running the same scanner marks the exam <span class="q">using the answers the student wrote.</span>
    </p>

    <p class="reveal body mt-10" style="--reveal-delay:60ms;max-width:62ch">
      So we write the test before the fixer sees the problem. Other ways to exploit the
      same weakness, and ordinary inputs that should keep working. We lock them away.
      After the patch lands, we run them.
    </p>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows
        label="A verified fix requires all four conditions"
        text
        narrow
        rows={conditions.map((v, i) => ({ k: String(i + 1).padStart(2, '0'), v }))}
      />
    </div>

    <p class="reveal body mt-8 text-fg-2" style="--reveal-delay:60ms;max-width:66ch">
      It is a narrow claim, deliberately. It does not mean your code is secure. It means
      this hole, on the paths we could test, is shut. Anyone offering more than that is
      offering something we do not think can be honestly given.
    </p>
  </Section>

  <Section id="columns">
    <Eyebrow class="reveal">Reading the table</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">The gap is the finding.</h2>

    <div class="reveal mt-10" style="--reveal-delay:120ms">
      <ReportRows
        text
        rows={columns.map((col, i) => ({ k: `Column ${String(i + 1).padStart(2, '0')}`, title: col.name, v: col.body }))}
      />
    </div>
  </Section>

  <Section id="research">
    <Eyebrow class="reveal">Research</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">The Index&rsquo;s working.</h2>

    <p class="reveal body mt-8" style="--reveal-delay:120ms;max-width:62ch">
      Every number the Index will publish is backed by a pilot, a note, or a correction
      written up here first, in the order it happened.
    </p>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows
        text
        rows={posts.map((post, i) => ({
          k: `Issue ${issueOf(i)} · ${filed(post.frontmatter.date)}`,
          title: post.frontmatter.title,
          v: post.frontmatter.description,
          href: post.url,
        }))}
      />
    </div>

    <p class="reveal mt-10">
      <a href="/research" class="link-inline">All research</a>
    </p>
  </Section>

  <Section id="rules" tint>
    <Eyebrow class="reveal">Rules we hold ourselves to</Eyebrow>
    <h2 class="h2 reveal" style="--reveal-delay:60ms">
      How we stop ourselves from cheating.
    </h2>

    <div class="reveal mt-10" style="--reveal-delay:60ms">
      <ReportRows text rows={rules.map(([k, v]) => ({ k, v }))} />
    </div>

    <p class="reveal mt-10">
      <a href="/methodology#index-rules" class="link-inline">Read the full methodology</a>
    </p>
  </Section>

  <Section id="background">
    <h2 class="h2 reveal">Background, not evidence.</h2>
    <p class="reveal body mt-8 text-fg-2" style="--reveal-delay:60ms;max-width:66ch">
      The numbers below are other people&rsquo;s. They are why an independent Index needs to
      exist; they are not our finding. Ours is the measurement above and in the research.
    </p>
  </Section>

  <EcosystemBar />
  <StructuralProblem />
  <VerificationGap />
</BaseLayout>
