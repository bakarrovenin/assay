---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGovernance from '../components/HeroGovernance.astro';
import Hero from '../components/Hero.astro';
import EcosystemBar from '../components/EcosystemBar.astro';
import VerificationGap from '../components/VerificationGap.astro';
import WorkedExample from '../components/WorkedExample.astro';
import StructuralProblem from '../components/StructuralProblem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Workflow from '../components/Workflow.astro';
import IndexSection from '../components/IndexSection.astro';
import Compliance from '../components/Compliance.astro';
import Integrations from '../components/Integrations.astro';
import Pricing from '../components/Pricing.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site } from '../lib/site';
---

<BaseLayout title="Independent verification for AI-authored code" description={site.description} path="/">
  <HeroGovernance />
  <span id="see-it-work" aria-hidden="true"></span>
  <Hero />
  <EcosystemBar />
  <VerificationGap />
  <WorkedExample />
  <StructuralProblem />
  <HowItWorks />
  <Workflow />
  <IndexSection />
  <Compliance />
  <Integrations />
  <Pricing />
  <FinalCTA />
</BaseLayout>
