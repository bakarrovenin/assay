---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    author: string;
    readingTime: string;
    runDate?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, date, author, readingTime, runDate } = frontmatter;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
// Optional: when the work predates publication, show both, so the byline
// matches reality rather than collapsing to a single date.
const formattedRun = runDate
  ? new Date(runDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })
  : null;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="section-hero rule-b">
      <div class="shell">
        <p class="hd reveal">Research</p>

        <h1 class="h1 reveal mt-6" style="--reveal-delay:60ms">{title}</h1>

        <p class="lede reveal mt-8" style="--reveal-delay:120ms">{description}</p>

        <p class="disc reveal mt-8" style="--reveal-delay:180ms">
          {author} &middot; {
            formattedRun ? (
              <Fragment>Run {formattedRun}, published <time datetime={date}>{formatted}</time></Fragment>
            ) : (
              <time datetime={date}>{formatted}</time>
            )
          } &middot; {readingTime}
        </p>
      </div>
    </header>

    <div class="section">
      <div class="shell">
        <div class="longform reveal">
          <slot />
        </div>

        <p class="mt-16 border-t border-line pt-8">
          <a href="/research" class="link-inline">&larr; All research</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
