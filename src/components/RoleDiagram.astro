---
import TermPanel from './system/TermPanel.astro';
import CheckRow from './system/CheckRow.astro';

const roles = [
  { n: 'Role 01', title: 'Writes the fix', by: 'the same vendor' },
  { n: 'Role 02', title: 'Reviews the fix', by: 'the same vendor' },
  { n: 'Role 03', title: 'Certifies the fix', by: 'the same vendor' },
] as const;
---

<TermPanel path="who does what">
  {roles.map((role) => <CheckRow id={role.n} name={role.title} desc={role.by} state="pending" status="" />)}
  {/* The vacant seat is the one the section is about. */}
  <CheckRow id="Role 04, vacant" name="Independently verifies the fix" desc="nobody" state="pending" status="" class="is-mark" />
</TermPanel>
