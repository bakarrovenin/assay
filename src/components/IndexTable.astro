---
// No results yet. Every cell is an empty state on purpose: the first edition
// has not published, and inventing numbers here would be the exact failure
// this company was started to point at.
//
// The rows are the general coding assistants developers actually use to fix
// a flagged vulnerability, plus the open DARPA systems as the baseline row.
// Dedicated remediation products are out of scope for this edition; the page
// says so beneath the sheet.
import Table from './system/Table.astro';

const tools = [
  'ChatGPT',
  'Claude Code',
  'Cursor',
  'GitHub Copilot Autofix',
  'OpenAI Codex',
  'DARPA AIxCC (open source)',
];

const EMPTY = '—';

const COLUMNS = ['Fixes tested', 'Alert closed', 'Verified fix'] as const;
---

<div class="reveal">
  {/* Sheet header. Metadata left, the state of the edition right. The state
      is the one accent here: it is what the empty table means. */}
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <span class="hd">Quarterly · method v1.0</span>
    <span class="hd" style="color:var(--acc)">First edition in progress</span>
  </div>

  <Table
    columns={[{ label: 'Tool' }, ...COLUMNS.map((h) => ({ label: h, num: true }))]}
    caption="Assay Index results by tool. No results have been published yet: the first edition is in progress, so every value is empty."
    minWidth={520}
  >
    {
      tools.map((tool) => (
        <tr>
          <th scope="row">{tool}</th>
          {COLUMNS.map((h) => (
            <td class="num is-dim" data-label={h}>{EMPTY}</td>
          ))}
        </tr>
      ))
    }
  </Table>
</div>
