---
// No results yet. Every cell is an empty state on purpose: the first edition
// has not published, and inventing numbers here would be the exact failure
// this company was started to point at.
const tools = [
  'GitHub Copilot Autofix',
  'Cursor',
  'Claude Code',
  'OpenAI Codex',
  'Snyk',
  'Pixee',
  'Mobb',
  'ZeroPath',
  'DARPA AIxCC (open source)',
];

const EMPTY = '—';

const COLUMNS = ['Fixes tested', 'Alert closed', 'Verified fix'] as const;
---

<div class="sheet reveal">
  {/* Sheet header. Metadata left, the state of the edition right. The state
      is the one accent here: it is what the empty table means. */}
  <div class="sheet-head">
    <span>Quarterly · method v1.0</span>
    <span class="sheet-state">First edition in progress</span>
  </div>

  <div class="sheet-scroll">
    <table class="sheet-table">
      <caption class="sr-only">
        Assay Index results by tool. No results have been published yet: the first
        edition is in progress, so every value is empty.
      </caption>
      <thead>
        <tr>
          <th scope="col" class="col-tool">Tool</th>
          {
            COLUMNS.map((h) => <th scope="col" class="col-figure">{h}</th>)
          }
        </tr>
      </thead>
      <tbody>
        {
          tools.map((tool) => (
            <tr>
              <th scope="row" class="cell-tool">{tool}</th>
              {COLUMNS.map((h) => (
                <td class="cell-figure" data-label={h}>
                  {EMPTY}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  /* A results sheet: ruled top and bottom, column rules between figures,
     no box around it and no alternating row fill. */
  .sheet {
    border-top: 1px solid var(--line);
  }

  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--t-meta-track);
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .sheet-state {
    color: var(--accent);
  }

  .sheet :global(table) {
    border-collapse: collapse;
  }

  .sheet :global(th),
  .sheet :global(td) {
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
  }

  .sheet :global(thead th) {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    font-weight: 500;
    letter-spacing: var(--t-meta-track);
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .sheet :global(.col-tool),
  .sheet :global(.cell-tool) {
    padding-left: 0;
    text-align: left;
  }

  .sheet :global(.col-figure),
  .sheet :global(.cell-figure) {
    text-align: right;
    /* The column rule. This is what separates values on a sheet. */
    border-left: 1px solid var(--line);
  }

  .sheet :global(.cell-tool) {
    font-size: 15px;
    font-weight: 500;
  }

  .sheet :global(.cell-figure) {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg-3);
  }

  .sheet :global(tbody tr:last-child th),
  .sheet :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .sheet-table {
    width: 100%;
    text-align: left;
  }

  @media (min-width: 640px) {
    .sheet-scroll {
      overflow-x: auto;
    }

    .sheet-table {
      min-width: 560px;
    }
  }

  /* Narrow: the sheet stacks into one record per tool rather than scrolling a
     column off the edge. Every figure stays on screen and carries its own
     column name, so the reader can see what the sheet holds and that all of
     it is empty, which is the point of the page. */
  @media (max-width: 639px) {
    .sheet :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .sheet :global(tbody tr) {
      display: block;
      border-bottom: 1px solid var(--line);
    }

    .sheet :global(tbody tr:last-child) {
      border-bottom: 0;
    }

    .sheet :global(.cell-tool) {
      display: block;
      padding: 16px 0 10px;
      border-bottom: 0;
    }

    .sheet :global(.cell-figure) {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 7px 0 7px 16px;
      border-left: 1px solid var(--line);
      border-bottom: 0;
      text-align: left;
    }

    .sheet :global(.cell-figure):last-child {
      padding-bottom: 16px;
    }

    /* The column name travels with the figure once the header row is gone. */
    .sheet :global(.cell-figure)::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: var(--t-meta);
      letter-spacing: var(--t-meta-track);
      text-transform: uppercase;
      color: var(--fg-3);
    }
  }
</style>
