---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import ReportRows from './system/ReportRows.astro';
import Strip from './system/Strip.astro';

// The two terms of art the repair literature separates. Shown rather than
// explained: the gap between the words is the argument.
const terms = [
  { k: 'Plausible', v: 'Passes every test it was given.' },
  { k: 'Correct', v: 'Fixes the bug.' },
] as const;

const bars = [
  {
    label: 'Classic repair tool (GenProg)',
    value: 2,
    display: '2%',
    note: '98% were overfitting',
  },
  {
    label: 'Strong 2024 frontier method (D4C)',
    value: 50,
    display: '~50%',
    note: 'roughly a coin flip',
  },
  {
    label: 'Five frontier models on 20 real CVEs, 2026',
    value: 50,
    display: '50%',
    note: 'best solve rate',
  },
];

const stats = [
  {
    value: '45%',
    label:
      'of AI-generated code ships an OWASP Top 10 vulnerability, and the rate is flat across model generations.',
    emphasise: 'flat',
    source: 'Veracode, 100+ LLMs, 2025',
  },
  {
    value: '42%',
    label: 'of committed code is now AI-generated.',
    source: 'Sonar, 1,100+ developers, 2026',
  },
  {
    value: '24%',
    label: 'of developers merge AI code without reviewing it at all.',
    source: 'Qodo, 2025',
  },
  {
    value: '43%',
    label: 'of AI code changes need debugging in production.',
    source: 'Lightrun, 2026',
  },
];
---

<Section id="verification-gap">
  <Eyebrow class="reveal">The verification gap</Eyebrow>
  <h2 class="h2 reveal" style="--reveal-delay:60ms">
    A patch can pass every test and leave the hole wide open.
  </h2>

  <p class="reveal body mt-8" style="--reveal-delay:120ms;max-width:74ch">
    A test is{' '}
    <strong class="font-medium text-fg">a sample, not a specification</strong>. The field
    has a word for the patches that satisfy the sample.
  </p>

  <div class="reveal mt-10" style="--reveal-delay:60ms">
    <ReportRows label="Automated program repair · terms of art" text rows={terms}>
      <Fragment slot="disc">The distance between them is called <b>overfitting</b></Fragment>
    </ReportRows>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
    <div class="space-y-8">
      {/* The remedy is not wrong, it was removed, so it is set as a line ruled
          through rather than deleted. */}
      <p class="reveal body">
        That literature was explicit about the remedy:{' '}
        <span class="struck">a human validates every candidate before anyone trusts it</span>.
      </p>
      {/* The conclusion of the whole section, so it carries weight rather than
          trailing off beside the figures. */}
      <p class="h2 reveal text-fg-2" style="--reveal-delay:60ms;max-width:22ch">
        AI agents did not solve overfitting.{' '}
        <span class="text-fg">They deleted the validation step and measured nothing in its place.</span>
      </p>
    </div>

    <div class="reveal">
      <ReportRows
        lead
        label="Test-passing patches that were actually correct"
        rows={bars.map((b) => ({ k: b.label, v: b.display, t: b.note, tone: b.value <= 2 ? 'fail' : undefined }))}
        disc="Sources: Qi et al. via Invalidator (arXiv 2301.01113) · D4C 2024 · independent CVE study, May 2026"
      />
    </div>
  </div>

  {/* Spec sheet: the figure leads, the source rides on the right. */}
  <div class="reveal mt-14">
    <ReportRows lead rows={stats.map((st) => ({ k: st.label, v: st.value, t: st.source }))} />
  </div>

  <div class="reveal mt-12 border-t border-line pt-6" style="max-width:76ch">
    <p class="hd mb-4">Why a better model does not fix this</p>
    <p class="body">
      You cannot wait this out: the lever is governance, not model capability.
    </p>
  </div>
</Section>

<Strip>
  &ldquo;The alert turning green and the bug being fixed are two different events.{' '}
  <span class="q">The industry measures the first one.</span>&rdquo;
</Strip>
