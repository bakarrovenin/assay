---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import StatCard from './StatCard.astro';
import VerificationChart from './VerificationChart.astro';
import DefinitionPair from './DefinitionPair.astro';

// The two terms of art the repair literature separates. Shown rather than
// explained: the gap between the words is the argument.
const terms = [
  { term: 'Plausible', definition: 'Passes every test it was given.' },
  { term: 'Correct', definition: 'Fixes the bug.' },
] as const;

const bars = [
  {
    label: 'Classic repair tool (GenProg)',
    value: 2,
    display: '2%',
    note: '98% were overfitting',
  },
  {
    label: 'Strong 2024 frontier method (D4C)',
    value: 50,
    display: '~50%',
    note: 'roughly a coin flip',
  },
  {
    label: 'Five frontier models on 20 real CVEs, 2026',
    value: 50,
    display: '50%',
    note: 'best solve rate',
  },
];

const stats = [
  {
    value: '45%',
    label:
      'of AI-generated code ships an OWASP Top 10 vulnerability, and the rate is flat across model generations.',
    emphasise: 'flat',
    source: 'Veracode, 100+ LLMs, 2025',
  },
  {
    value: '42%',
    label: 'of committed code is now AI-generated.',
    source: 'Sonar, 1,100+ developers, 2026',
  },
  {
    value: '24%',
    label: 'of developers merge AI code without reviewing it at all.',
    source: 'Qodo, 2025',
  },
  {
    value: '43%',
    label: 'of AI code changes need debugging in production.',
    source: 'Lightrun, 2026',
  },
];
---

<Section id="verification-gap">
  <Eyebrow class="reveal">The verification gap</Eyebrow>

  <h2 class="h2 reveal" style="--reveal-delay:60ms">
    A patch can pass every test and leave the hole wide open.
  </h2>

  <p class="reveal mt-10 text-[17px] leading-[1.6] lg:text-[18px]" style="--reveal-delay:120ms;max-width:74ch">
    A test is{' '}
    <strong class="font-semibold text-fg">a sample, not a specification</strong>. The field
    has a word for the patches that satisfy the sample.
  </p>

  <div class="reveal mt-11" style="--reveal-delay:60ms">
    <DefinitionPair
      label="Automated program repair · terms of art"
      terms={terms}
      footer="The distance between them is called "
      footerTerm="overfitting"
    />
  </div>

  <div class="mt-14 grid grid-cols-1 gap-14 lg:mt-16 lg:grid-cols-[minmax(0,1.06fr)_minmax(0,1fr)] lg:gap-16">
    <div class="space-y-8">
      {/* The one struck layer on the sheet. The remedy is not wrong, it was
          removed, so it is set as a line ruled through rather than deleted. */}
      <p class="reveal text-[17px] leading-[1.6]">
        That literature was explicit about the remedy:{' '}
        <span class="struck">a human validates every candidate before anyone trusts it</span>.
      </p>

      {/* The conclusion of the whole section, so it carries weight rather than
          trailing off beside a full-height chart. */}
      <p
        class="reveal font-display text-[22px] font-bold leading-[1.25] tracking-[-0.016em] text-fg-2 lg:text-[26px]"
        style="--reveal-delay:60ms;max-width:22ch"
      >
        AI agents did not solve overfitting.{' '}
        <span class="text-fg">They industrialised it and deleted the validation step.</span>
      </p>
    </div>

    <VerificationChart
      title="Test-passing patches that were actually correct"
      caption="Sources: Qi et al. via Invalidator (arXiv 2301.01113) · D4C 2024 · independent CVE study, May 2026"
      bars={bars}
      class="lg:pt-1"
    />
  </div>

  {/* Spec sheet. Numbered zones, each figure carried out on a leader line. */}
  <div class="reveal mt-20 border-t border-line lg:mt-24">
    {
      stats.map((stat, i) => (
        <StatCard
          n={String(i + 1).padStart(2, '0')}
          value={stat.value}
          label={stat.label}
          emphasise={stat.emphasise}
          source={stat.source}
        />
      ))
    }
  </div>

  <div
    class="reveal mt-14 border-t border-line pt-6 lg:mt-16"
    style="max-width:76ch"
  >
    <p class="micro mb-3">Why a better model does not fix this</p>
    <p class="text-[16.5px] leading-[1.62]">
      You cannot wait this out: the lever is governance, not model capability.
    </p>
  </div>

  <blockquote
    class="reveal mt-20 border-l-2 border-accent pl-6 lg:mt-24 lg:pl-8"
  >
    <p class="font-display text-[22px] font-bold leading-[1.3] tracking-[-0.018em] lg:text-[27px]" style="max-width:28ch">
      &ldquo;The alert turning green and the bug being fixed are two different events.
      The industry measures the first one.&rdquo;
    </p>
  </blockquote>

  <style>
    /* Struck, not deleted: the step was removed from practice, not disproved. */
    .struck {
      text-decoration: line-through;
      text-decoration-thickness: 1px;
      text-decoration-color: var(--fg-3);
      color: var(--fg-2);
    }
  </style>
</Section>
