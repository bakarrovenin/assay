---
interface Props {
  /** Zone number on the sheet, e.g. "01". */
  n?: string;
  /** The headline number as displayed, e.g. "45%" or "3 to 4x". */
  value: string;
  label: string;
  /**
   * A substring of `label` to set in the foreground weight. Used where the
   * emphasis is the claim, not decoration: "the rate is flat" is the point
   * of the Veracode number, not the 45%.
   */
  emphasise?: string;
  source: string;
  class?: string;
}

const { n, value, label, emphasise, source, class: className = '' } = Astro.props;

// Split rather than interpolate HTML, so the label stays plain text.
const i = emphasise ? label.indexOf(emphasise) : -1;
const parts =
  i >= 0
    ? { before: label.slice(0, i), mark: emphasise!, after: label.slice(i + emphasise!.length) }
    : null;

// Only animate when the value is a plain number with optional prefix/suffix.
const match = value.match(/^(\D*?)(\d+(?:\.\d+)?)(\D*)$/);
const countable = match !== null;
---

<div class={`zone ${className}`}>
  <div class="zone-head">
    {n && <span class="zone-n">{n}</span>}

    <p class="zone-label">
      {
        parts ? (
          <>
            {parts.before}
            <strong>{parts.mark}</strong>
            {parts.after}
          </>
        ) : (
          label
        )
      }
    </p>

    <span class="leader" aria-hidden="true"></span>

    <div
      class="zone-value"
      data-stat={countable ? '' : undefined}
      data-target={match?.[2]}
      data-prefix={match?.[1]}
      data-suffix={match?.[3]}
    >
      {value}
    </div>
  </div>

  <p class="zone-source">{source}</p>
</div>

<style>
  /* A zone on a spec sheet: ruled, numbered, with the figure carried out to
     the edge on a leader line. Was a bordered card; a spec sheet is ruled,
     not boxed. */
  .zone {
    border-bottom: 1px solid var(--line);
    padding: 18px 0 16px;
  }

  .zone-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .zone-n {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--t-meta-track);
    color: var(--fg-3);
    flex: none;
  }

  .zone-label {
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-2);
    max-width: 56ch;
  }

  .zone-label strong {
    font-weight: 600;
    color: var(--fg);
  }

  /* Carries the eye from the claim to the figure. Structure, not ornament:
     without it the number floats away from what it measures. */
  .leader {
    flex: 1 1 auto;
    min-width: 24px;
    align-self: flex-end;
    margin-bottom: 6px;
    border-bottom: 1px dotted var(--line);
  }

  .zone-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 2.8vw, 38px);
    line-height: 1;
    letter-spacing: -0.02em;
    flex: none;
  }

  .zone-source {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--t-meta-track);
    text-transform: uppercase;
    color: var(--fg-3);
    margin-top: 9px;
    padding-left: 34px;
  }

  @media (max-width: 640px) {
    .zone-head {
      flex-wrap: wrap;
    }
    .zone-label {
      flex: 1 1 100%;
      order: 3;
      padding-left: 34px;
      margin-top: 6px;
    }
    .leader {
      order: 2;
    }
    .zone-source {
      margin-top: 8px;
    }
  }
</style>

<script>
  const stats = document.querySelectorAll<HTMLElement>('[data-stat]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stats.length && !reduced && 'IntersectionObserver' in window) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.target);
      if (!Number.isFinite(target)) return;

      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';
      const decimals = (el.dataset.target ?? '').split('.')[1]?.length ?? 0;
      const duration = 900;
      const start = performance.now();

      const frame = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const current = target * easeOut(t);
        el.textContent = prefix + current.toFixed(decimals) + suffix;
        if (t < 1) requestAnimationFrame(frame);
      };

      requestAnimationFrame(frame);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.5 },
    );

    stats.forEach((el) => io.observe(el));
  }
</script>
