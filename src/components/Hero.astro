---
// Single column. The certificate used to sit beside the headline as the
// hero's primary object; it now assembles beat by beat in the explainer
// section directly below, so nothing is duplicated here and the headline
// gets the width back.
---

<section class="hero">
  <div class="shell">
    <div class="hero-text">
      <p class="eyebrow reveal">Independent verification for AI-authored code</p>

      <h1 class="h1 hero-h1 reveal mt-6" style="--reveal-delay:60ms">
        Your AI fixed it. We check whether it actually did.
      </h1>

      <p class="lede reveal mt-8" style="--reveal-delay:120ms">
        Every AI security tool now writes its own patches and certifies its own work.
        Assay is the third party that checks.
      </p>

      <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay:180ms">
        <button type="button" class="btn btn-primary" data-verify-cta>Verify a pull request</button>
        <a href="/the-index" class="btn btn-secondary">Read the Index</a>
      </div>

      <p class="mono reveal mt-6 text-[12px] text-fg-2" style="--reveal-delay:240ms">
        Free forever on public repositories &middot; Installs in under a minute
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding-block: 64px 72px;
  }

  /* Full display size. The stage 2 rebuild took the headline from 80 to 72
     because it had to share the row with the certificate and still fit the
     viewport. That constraint is gone with the column, so the size comes
     back with it. 22ch lets the line set to two lines across the shell at
     1512, breaking after "check" rather than after "We". */
  .hero-h1 {
    font-size: clamp(40px, 6.4vw, 80px);
    max-width: 22ch;
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: 96px 104px;
    }
  }

  @media (min-width: 960px) and (max-height: 760px) {
    .hero {
      padding-block: 64px 72px;
    }
  }
</style>
