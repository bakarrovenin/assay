---
interface Props {
  /** Pre-tokenised HTML. Built by hand: no runtime highlighter ships. */
  html: string;
  label?: string;
  class?: string;
}

const { html, label, class: className = '' } = Astro.props;
---

<div class={`panel-dark overflow-hidden ${className}`}>
  {
    label && (
      <div
        class="mono border-b border-[color:var(--color-panel-line)] px-4 py-2.5 text-[10px] uppercase tracking-[0.16em] text-[color:var(--color-panel-fg-2)]"
      >
        {label}
      </div>
    )
  }
  <pre class="code-pre overflow-x-auto px-4 py-4"><code set:html={html} /></pre>
</div>

<style is:global>
  .code-pre {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    tab-size: 2;
  }

  @media (min-width: 640px) {
    .code-pre { font-size: 13px; }
  }

  /* #6E7681 read 4.08:1 on the panel, under AA. #7C848F is 4.96:1. */
  .code-pre .tok-com { color: #7C848F; font-style: italic; }
  .code-pre .tok-kw  { color: #C99BF0; }
  .code-pre .tok-fn  { color: #77B7FF; }
  .code-pre .tok-str { color: #9BD69B; }
  .code-pre .tok-var { color: var(--color-panel-fg); }
  .code-pre .tok-mut { color: #E8B978; }
  .code-pre .tok-bad { color: var(--color-panel-fail); }
</style>
