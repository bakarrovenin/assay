---
interface Props {
  /** Pre-tokenised HTML. Built by hand: no runtime highlighter ships. */
  html: string;
  label?: string;
  class?: string;
}

const { html, label, class: className = '' } = Astro.props;
---

<div class={`panel-dark overflow-hidden ${className}`}>
  {
    label && (
      <div
        class="mono border-b border-[color:var(--color-code-line)] px-4 py-2.5 text-[10px] uppercase tracking-[0.16em] text-[color:var(--color-code-fg-2)]"
      >
        {label}
      </div>
    )
  }
  <pre class="code-pre overflow-x-auto px-4 py-4"><code set:html={html} /></pre>
</div>

<style is:global>
  .code-pre {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    tab-size: 2;
  }

  @media (min-width: 640px) {
    .code-pre { font-size: 13px; }
  }
</style>
