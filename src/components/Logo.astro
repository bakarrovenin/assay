---
import { BRAND_PATH } from '../lib/brand';
interface Props { size?: number; wordmark?: boolean; class?: string; }
const { size = 30, wordmark = true, class: className = '' } = Astro.props;
---
<span class={`assay-brand ${className}`}>
  <svg width={size} height={size} viewBox="0 0 34 34" fill="none" aria-hidden="true"><path d={BRAND_PATH} stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" /></svg>
  {wordmark && <span>assay</span>}
</span>
<style>
.assay-brand { display:inline-flex; align-items:center; gap:10px; color:var(--fg); white-space:nowrap; }
.assay-brand svg { color:var(--acc); flex-shrink:0; }
.assay-brand>span { font-family:Inter,sans-serif; font-size:24px; font-weight:750; line-height:1; letter-spacing:-.055em; }
</style>
