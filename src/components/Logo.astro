---
interface Props {
  /** Pixel size of the square mark. */
  size?: number;
  /** Render the ASSAY wordmark beside the mark. */
  wordmark?: boolean;
  class?: string;
}

const { size = 20, wordmark = true, class: className = '' } = Astro.props;
---

<span class={`brand ${className}`}>
  <span class="sq" style={`width:${size}px;height:${size}px`} aria-hidden="true">
    {/* Assay mark: the check stroke of the hallmark punch, inside the
        bordered square the system uses for the brand. */}
    <svg width={size - 6} height={size - 6} viewBox="0 0 24 24" fill="none">
      <path
        d="M5 12.6l4.6 4.8L19.4 6.6"
        stroke="currentColor"
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
  {wordmark && <span>ASSAY</span>}
</span>
