---
interface Props {
  /** Pixel size of the square mark. */
  size?: number;
  /** Render the ASSAY wordmark beside the mark. */
  wordmark?: boolean;
  class?: string;
}

const { size = 22, wordmark = true, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-[9px] ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    {/* Assay mark: a hallmark punch. Square with the top-right corner
        notched off, carrying a check stroke. */}
    <path
      d="M2.4 2.4h13.2l6 6v13.2H2.4V2.4Z"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linejoin="round"
    />
    <path
      d="M7.4 12.4l3.2 3.4 6.2-6.6"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {
    wordmark && (
      <span
        class="font-display font-bold uppercase leading-none"
        style="letter-spacing:0.16em;font-size:15px"
      >
        Assay
      </span>
    )
  }
</span>
