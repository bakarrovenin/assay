---
// The opening screen. Deliberately stark: one statement, centred, full
// viewport. It uses the same tokens as every other section, so it inherits
// both themes rather than hardcoding the dark one.
---

<section class="hero-gov">
  <div class="shell hero-gov-inner">
    <p class="eyebrow reveal">Autonomous remediation governance</p>

    <h1 class="h1 gov-title reveal mt-6" style="--reveal-delay:60ms">
      Remediation is autonomous.<br />
      <span class="gov-title-muted">Governance isn&rsquo;t.</span>
    </h1>

    <p class="lede gov-lede reveal mt-7" style="--reveal-delay:120ms">
      AI writes the fix, marks its own work done, and merges it. Assay is the
      final layer, the independent third party that verifies whether it
      actually did.
    </p>

    <div
      class="reveal mt-9 flex flex-wrap justify-center gap-3"
      style="--reveal-delay:180ms"
    >
      <button type="button" class="btn btn-primary" data-verify-cta>
        Verify a pull request
      </button>
      <a href="/the-index" class="btn btn-secondary">Read the Index</a>
    </div>

    <p
      class="mono reveal mt-6 text-[12px] text-fg-2"
      style="--reveal-delay:240ms"
    >
      Free forever on public repositories &middot; Installs in under a minute
    </p>
  </div>

  <a href="#see-it-work" class="gov-cue reveal" style="--reveal-delay:360ms">
    <span class="micro">See it work</span>
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M6 9.5l6 6 6-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </a>
</section>

<style>
  .hero-gov {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Exactly one screen under the 61px nav. svh so mobile browser chrome
       collapsing cannot clip the scroll cue. */
    min-height: calc(100svh - 61px);
    padding-block: 96px 112px;
    text-align: center;
  }

  .hero-gov-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* .h1 is sized for the 580px column in the second hero. This one is
     centred against the full shell, so it can carry more weight. */
  .gov-title {
    font-size: clamp(36px, 6.4vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.032em;
    max-width: 18ch;
  }

  .gov-title-muted {
    color: var(--fg-2);
  }

  .gov-lede {
    max-width: 60ch;
  }

  .gov-cue {
    position: absolute;
    bottom: 34px;
    /* Centred with auto margins, not translateX: .reveal.is-in sets
       transform:none once the element animates in, which would wipe out a
       centring transform and shunt the cue off axis by half its width. */
    left: 0;
    right: 0;
    margin-inline: auto;
    width: fit-content;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    color: var(--fg-2);
    transition: color 150ms ease-out, opacity 150ms ease-out;
  }

  .gov-cue:hover {
    color: var(--fg);
  }

  .gov-cue svg {
    animation: cue-drift 2.4s ease-in-out infinite;
  }

  @keyframes cue-drift {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gov-cue svg { animation: none; }
  }

  /* Short screens: the cue and the block would collide, so drop the cue and
     let the content sit on its own. */
  @media (max-height: 620px) {
    .hero-gov { padding-block: 72px; }
    .gov-cue { display: none; }
  }
</style>
