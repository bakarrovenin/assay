---
import Section from './Section.astro';
---

<Section id="cta" tint class="text-center">
  <h2 class="h2 reveal mx-auto">Take nobody&rsquo;s word for it.</h2>

  <p class="lede reveal mx-auto mt-6" style="--reveal-delay:60ms">
    Give any fixer one of the four flaws, paste the patch back, and see the four checks on it.
  </p>

  <div
    class="reveal mt-9 flex flex-wrap justify-center gap-3"
    style="--reveal-delay:120ms"
  >
    <a href="/benchmark" class="btn btn-primary">Run the benchmark</a>
    <a href="/the-index" class="btn btn-secondary">Read the Index</a>
  </div>

  {/* The pull-request verifier is a labelled waitlist, not a primary CTA, and
      keeps its Loops "verify-pr" userGroup via the shared data-verify-cta modal. */}
  <div class="reveal mx-auto mt-14 max-w-[52ch] border-t border-line pt-7" style="--reveal-delay:60ms">
    <p class="micro mb-3">Coming later &middot; waitlist</p>
    <p class="text-[15.5px] leading-[1.6] text-fg-2">
      A verifier that runs on every pull request, on your own repositories, is in development.
      <button type="button" class="link-inline font-medium text-fg" data-verify-cta>Join the waitlist</button>
    </p>
  </div>
</Section>
