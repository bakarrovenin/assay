---
import Section from './Section.astro';
import Strip from './system/Strip.astro';
import TermPanel from './system/TermPanel.astro';
import DiffRow from './system/DiffRow.astro';
import type { DiffLine } from './system/DiffRow.astro';
import ReportRows from './system/ReportRows.astro';

// Move 3, THE HEART. Held off the homepage until vendor right of reply closes:
// the three mechanisms are identifiable from the public evidence repo in about
// a minute, so this stays on the branch and drops into index.astro on the day
// (see the slot comment there). It names no vendor and shows no per-tool
// verdict, so it can ship unedited.
//
// Numbers verified against assay-pilot-001-evidence @ 3501e50:
//   4 flaws (findings 01/04/08/13), 3 commercial fixers scored blind.
// Mechanism 1: finding-08, an incomplete allow-list, scanner reads clean.
// Mechanism 2: finding-08 note 13, the reformat that closes the alert.
// Mechanism 3: finding-13, CodeQL default suite, 43 rules, 0 results.

const EVIDENCE = 'https://github.com/bakarrovenin/assay-pilot-001-evidence';

const describe = (file: string, lines: DiffLine[]) =>
  `Diff of ${file}. ${lines
    .filter((l) => l.mark)
    .map((l) => `${l.mark === '+' ? 'Added' : 'Removed'} line ${l.n}: ${l.html.replace(/<[^>]+>/g, '').replace(/&quot;/g, '"')}.`)
    .join(' ')}`;

const k = (s: string) => `<span class="tok-kw">${s}</span>`;
const c = (s: string) => `<span class="tok-com">${s}</span>`;
const t = (s: string) => `<span class="tok-str">${s}</span>`;
const Q = '&quot;';

// Mechanism 1: the allow-list that reads as clean but drops real columns.
const allowList: DiffLine[] = [
  { n: 36, mark: '+', html: `    ${c('# restrict the sort column')}` },
  { n: 37, mark: '+', html: `    allowed = {${t(`${Q}id${Q}`)}, ${t(`${Q}name${Q}`)}, ${t(`${Q}price${Q}`)}}` },
  { n: 38, mark: '+', html: `    ${k('if')} column ${k('not in')} allowed:` },
  { n: 39, mark: '+', html: `        column = ${t(`${Q}name${Q}`)}` },
  { n: 40, html: '' },
  { n: 41, html: `    query = f${t(`${Q}... ORDER BY {column}${Q}`)}` },
];

// Mechanism 2: the reformat. One f-string becomes two, interpolation intact.
const reformat: DiffLine[] = [
  { n: 41, mark: '-', html: `    query = f${t(`${Q}SELECT id, name, {column} AS f FROM products ORDER BY {column}${Q}`)}` },
  { n: 41, mark: '+', html: `    query = (` },
  { n: 42, mark: '+', html: `        f${t(`${Q}SELECT id, name, {column} AS f ${Q}`)}` },
  { n: 43, mark: '+', html: `        f${t(`${Q}FROM products ORDER BY {column}${Q}`)}` },
  { n: 44, mark: '+', html: '    )' },
];
---

<Section id="finding" rule={true}>
  <h2 class="h2 reveal">We ran the check nobody runs.</h2>

  <p class="reveal body mt-8" style="--reveal-delay:60ms;max-width:66ch">
    Four SQL injection flaws, three commercial fixers. Each was given only the file and one
    example attack, then the patch was hit with attacks it never saw. Here is what the
    scanner missed.
  </p>
</Section>

{/* Protected line 2, the Finding's own subject: patches that pass the
    scanner with the hole open. Set as the statement strip. */}
<Strip>
  A patch can pass every test and <span class="q">leave the hole wide open.</span>
</Strip>

<Section id="finding-proofs" rule={false}>
  <div class="grid grid-cols-1 gap-14">
    {/* Proof 1 */}
    <div class="reveal">
      <h3 class="h3">1 &middot; The allow-list that reads as clean</h3>
      <p class="body mt-3 text-fg-2">
        A fixer restricted the sort column to an allow-list, and the scanner reported the
        finding closed. The list left out real columns, so ordinary sorts silently return the
        wrong order. Secure against injection, and broken for users, scored a success.
      </p>
      <div class="mt-6">
        <TermPanel path="app/finding_08.py · allow-list" label={describe('app/finding_08.py', allowList)}
          footer="Scanner: 0 findings. Behaviour check: sorts by the dropped columns diverge.">
          <span slot="bar" class="term-count"><b>+4</b> &minus;0</span>
          <div class="term-block">{allowList.map((l) => <DiffRow line={l} />)}</div>
        </TermPanel>
      </div>
    </div>

    {/* Proof 2 */}
    <div class="reveal">
      <h3 class="h3">2 &middot; The reformat that closes the alert</h3>
      <p class="body mt-3 text-fg-2">
        Another split one formatted string into two, the interpolation unchanged. The rule
        matches a single formatted string reaching the query, so the alert closed. The alert
        was responding to the line wrapping, not to the fix. A correct fix and an evasion look
        identical to the scanner.
      </p>
      <div class="mt-6">
        <TermPanel path="app/finding_08.py · reformat" label={describe('app/finding_08.py', reformat)}
          footer="Scanner before: 1 finding. After: 0. The value is still interpolated, twice.">
          <span slot="bar" class="term-count"><b>+4</b> &minus;1</span>
          <div class="term-block">{reformat.map((l) => <DiffRow line={l} />)}</div>
        </TermPanel>
      </div>
    </div>

    {/* Proof 3 */}
    <div class="reveal">
      <h3 class="h3">3 &middot; The flaw the scanner never saw</h3>
      <p class="body mt-3 text-fg-2">
        The fourth flaw stores the input in one function and uses it in another. The scanner
        did not track the taint across the store and reload, so it raised nothing at all.
        Nothing was reported, so nothing was fixed.
      </p>
      <div class="mt-6">
        <ReportRows
          lead
          label="CodeQL default suite, Python, second-order flaw"
          rows={[
            { k: 'rules ran to completion.', v: '43' },
            { k: 'results. The rule that did not fire: py/sql-injection.', v: '0', tone: 'fail' },
          ]}
        />
      </div>
    </div>
  </div>

  <p class="reveal body mt-12 text-fg-2" style="max-width:74ch">
    One weakness class, four flaws, three tools. A signal, not a rate. We did not catch these
    fixers leaving holes open; the failure we found is in the measurement.
  </p>

  <p class="reveal mt-8">
    <a href={EVIDENCE} rel="noopener" class="link-inline">
      The corpus, the patches and the per-check evidence
    </a>
  </p>
</Section>
