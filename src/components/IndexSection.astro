---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import IndexSignup from './IndexSignup.astro';

// Homepage teaser only. The results table lives on /the-index, where the
// "first edition in progress" framing explains why every cell is empty.
---

<Section id="the-index" tint>
  <Eyebrow class="reveal">The Index</Eyebrow>

  <h2 class="h2 reveal" style="--reveal-delay:60ms">Which AI fixers actually work?</h2>

  <p class="lede reveal mt-6" style="--reveal-delay:120ms">
    Nobody has independently tested them. Every published number comes from the vendor
    that wrote the fix.
  </p>

  <p class="reveal mt-7" style="--reveal-delay:180ms">
    <a href="/the-index" class="link-inline text-[15px] font-medium">
      Read the Index and how it is scored
    </a>
  </p>

  <div class="mt-11">
    <IndexSignup />
  </div>
</Section>
