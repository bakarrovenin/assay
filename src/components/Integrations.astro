---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import BrandMark from './BrandMark.astro';
import type { BrandName } from '../lib/logos';

// Marks are used here, and only here, because these are things Assay plugs
// into. The tools the Index grades keep the abstract ToolChip glyphs: a logo
// sitting next to a score we are about to publish reads as endorsement.
const groups: {
  label: string;
  items: { brand: BrandName; name: string; body: string }[];
}[] = [
  {
    label: 'Where the change lands',
    items: [
      {
        brand: 'github',
        name: 'GitHub',
        body: 'A status check on every pull request. Blocking or advisory.',
      },
      {
        brand: 'gitlab',
        name: 'GitLab',
        body: 'The same check, on merge requests.',
      },
      {
        brand: 'bitbucket',
        name: 'Bitbucket',
        body: 'Reported through pipelines, on every pull request.',
      },
      {
        brand: 'azuredevops',
        name: 'Azure DevOps',
        body: 'Wired to branch policy, so the gate holds before merge.',
      },
    ],
  },
  {
    label: 'What we read',
    items: [
      {
        brand: 'snyk',
        name: 'Snyk and any SARIF scanner',
        body: 'SARIF in, verdict out. Works with whichever scanner you already run.',
      },
    ],
  },
  {
    label: 'Where the verdict goes',
    items: [
      {
        brand: 'slack',
        name: 'Slack',
        body: 'Verdicts where your team already triages.',
      },
      {
        brand: 'linear',
        name: 'Linear',
        body: 'On the issue that tracks the fix, not in a separate console.',
      },
      {
        brand: 'cursor',
        name: 'Cursor',
        body: 'An MCP server, so the agent sees its own score.',
      },
      {
        brand: 'claude',
        name: 'Claude Code',
        body: 'The same MCP server, in the terminal.',
      },
      {
        brand: 'openai',
        name: 'OpenAI Codex',
        body: 'REST API for anything that does not speak MCP.',
      },
    ],
  },
];

---

<Section id="integrations" tint>
  <Eyebrow class="reveal">Integrations</Eyebrow>

  <h2 class="h2 reveal" style="--reveal-delay:60ms">Wherever the change already lands.</h2>

  <div class="mt-10">
    {
      groups.map((group) => (
        <section class="group">
          <p class="micro reveal">{group.label}</p>

          <ul class="rows">
            {group.items.map((item, i) => (
              <li class="row reveal" style={`--reveal-delay:${Math.min(i, 3) * 45}ms`}>
                <span class="row-mark">
                  <BrandMark name={item.brand} size={19} />
                </span>
                <span class="row-name">{item.name}</span>
                <span class="row-body">{item.body}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="mono reveal mt-9 text-[11px] leading-relaxed text-fg-2" style="max-width:70ch">
    Marks belong to their owners. They are not endorsements, and no tool the Index
    grades is shown with its mark anywhere we publish a score.
  </p>
</Section>

<style>
  .group + .group {
    margin-top: 22px;
  }

  .rows {
    margin-top: 8px;
  }

  /* Ruled, not boxed. One hairline per row, including above the first, so the
     group label reads as a table head rather than a floating caption. */
  .row {
    display: grid;
    grid-template-columns: 19px minmax(0, 1fr);
    column-gap: 14px;
    row-gap: 2px;
    align-items: start;
    padding-block: 9px;
    border-top: 1px solid var(--line);
  }

  .row-mark {
    display: grid;
    place-items: center;
    color: var(--fg);
    /* Optical: the marks sit on the cap height of the name beside them. */
    padding-top: 2px;
  }

  .row-name {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--fg);
  }

  .row-body {
    grid-column: 2;
    font-size: 14px;
    line-height: 1.45;
    color: var(--fg-2);
  }

  /* One line per integration once there is room for a name column. */
  @media (min-width: 760px) {
    .row {
      grid-template-columns: 19px minmax(0, 210px) minmax(0, 1fr);
      column-gap: 18px;
      align-items: baseline;
      padding-block: 8px;
    }

    .row-mark {
      align-self: center;
      padding-top: 0;
    }

    .row-body {
      grid-column: 3;
    }
  }

  @media (min-width: 1180px) {
    .row {
      grid-template-columns: 19px minmax(0, 240px) minmax(0, 1fr);
    }
  }
</style>
