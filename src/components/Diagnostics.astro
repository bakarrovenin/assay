---
// Client assay. Reads only this browser, makes no network calls, stores
// nothing. Decorative, so it is hidden from assistive technology.
import TermPanel from './system/TermPanel.astro';
import VerdictLine from './system/VerdictLine.astro';

const rows = [
  ['User agent', 'ua'],
  ['Viewport', 'viewport'],
  ['Colour scheme', 'scheme'],
  ['Cores', 'cores'],
  ['Memory', 'memory'],
  ['Timezone', 'tz'],
  ['JavaScript', 'js'],
  ['Cookies', 'cookies'],
  ['Local storage', 'storage'],
] as const;
---

<div aria-hidden="true" data-diagnostics>
  <TermPanel path="Client assay" class="diag">
    {
      rows.map(([label, key]) => (
        <div class="ln out diag-row">
          <span class="diag-k">{label}</span>
          <span class="diag-v" data-field={key}>&mdash;</span>
        </div>
      ))
    }
    <VerdictLine label="UNVERIFIED" tone="fail" />
  </TermPanel>
</div>

<style>
  /* Layout only: the key column and the value truncation. */
  .diag-row {
    display: flex;
    gap: 12px;
    font-size: var(--t-desc);
    line-height: 1.9;
  }
  .diag-k {
    flex: none;
    width: 120px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    color: var(--fg-3);
  }
  .diag-v {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--fg-2);
  }
  [data-diagnostics] :global(.term) { box-shadow: none; }
  [data-diagnostics] :global(.term-body) { padding: 16px 18px 18px; }
  [data-diagnostics] :global(.verdictline) { margin-top: 12px; padding-top: 12px; }
</style>

<script>
  const root = document.querySelector('[data-diagnostics]');

  if (root) {
    // Every read is guarded: any of these can be absent or throw depending
    // on the browser and its privacy settings.
    const read = (fn: () => string | null | undefined): string => {
      try {
        const v = fn();
        return v == null || v === '' ? '—' : v;
      } catch {
        return '—';
      }
    };

    const values: Record<string, string> = {
      ua: read(() => navigator.userAgent),
      viewport: read(
        () => `${window.innerWidth} × ${window.innerHeight}`,
      ),
      scheme: read(() =>
        window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
      ),
      cores: read(() => {
        const n = navigator.hardwareConcurrency;
        return typeof n === 'number' ? String(n) : null;
      }),
      memory: read(() => {
        const gb = (navigator as Navigator & { deviceMemory?: number }).deviceMemory;
        return typeof gb === 'number' ? `${gb} GB` : null;
      }),
      tz: read(() => Intl.DateTimeFormat().resolvedOptions().timeZone),
      js: 'enabled',
      cookies: read(() => (navigator.cookieEnabled ? 'enabled' : 'disabled')),
      storage: read(() => {
        const k = '__assay_probe__';
        localStorage.setItem(k, '1');
        localStorage.removeItem(k);
        return 'available';
      }),
    };

    for (const [key, value] of Object.entries(values)) {
      const cell = root.querySelector(`[data-field="${key}"]`);
      if (cell) cell.textContent = value;
    }

    // The viewport line is the one value that changes under the reader.
    let frame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const cell = root.querySelector('[data-field="viewport"]');
        if (cell) cell.textContent = `${window.innerWidth} × ${window.innerHeight}`;
      });
    });
  }
</script>
