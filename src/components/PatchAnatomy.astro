---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import TermPanel from './system/TermPanel.astro';
import DiffRow from './system/DiffRow.astro';
import type { DiffLine } from './system/DiffRow.astro';
import VerdictPanel from './system/VerdictPanel.astro';
import TermLines, { describe } from './system/TermLines.astro';
import type { TermLine } from './system/TermLines.astro';
import CheckRow from './system/CheckRow.astro';

// The shape of a patch post-mortem, used twice on /methodology: once on a
// patch that overfits, once on the fix that actually closes the hole. The two
// sections share this file rather than merely resembling each other, so the
// reader recognises the shape and reads the differences instead of the layout.

export type Mark = { id: string; title: string; struck: boolean };

interface Props {
  id: string;
  eyebrow: string;
  headline: string;
  tint?: boolean;
  /** Label and value pairs beside the headline. Values may carry entities. */
  meta: readonly (readonly [string, string])[];
  diff: {
    file: string;
    tag: string;
    added: number;
    removed: number;
    lines: DiffLine[];
    footer: string;
  };
  /** Two sentences at full strength, then one dimmed. */
  prose: { lead: string; dim: string };
  verdict: {
    verdict: string;
    state: 'verified' | 'failed';
    rows: readonly (readonly [string, string])[];
  };
  /** Mono aside between the verdict and the probe: a muted line, then a plain one. */
  note: { muted: string; strong: string };
  terminal: { label: string; lines: TermLine[]; footer: string };
  hallmark: { marks: readonly Mark[]; caption: string };
}

const { id, eyebrow, headline, tint = false, meta, diff, prose, verdict, note, terminal, hallmark } =
  Astro.props;

const hallmarkLabel = `Hallmark. ${hallmark.marks
  .map((m) => `${m.title} ${m.struck ? 'struck' : 'not struck'}`)
  .join(', ')}.`;
---

<Section id={id} tint={tint}>
  <Eyebrow class="reveal">{eyebrow}</Eyebrow>
  <div class="grid grid-cols-1 gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,400px)] lg:gap-12 lg:items-start">
    <h2 class="h2 reveal" style="--reveal-delay:60ms">{headline}</h2>
    <div class="reveal lg:pt-2" style="--reveal-delay:120ms">
      {
        meta.map(([label, value]) => (
          <div class="ln out"><span class="cmt">{label}</span> <span class="text-fg" set:html={value} /></div>
        ))
      }
    </div>
  </div>

  <div class="reveal mt-10 border-t border-line pt-10" style="--reveal-delay:60ms">
    <TermPanel path={`${diff.file} · ${diff.tag}`} footer={diff.footer}>
      <span slot="bar" class="term-count"><b>+{diff.added}</b> &minus;{diff.removed}</span>
      <div class="term-block">{diff.lines.map((l) => <DiffRow line={l} />)}</div>
    </TermPanel>
  </div>

  <p class="reveal body mt-10" style="--reveal-delay:60ms;max-width:70ch">
    {prose.lead}{' '}
    <span class="text-fg-2">{prose.dim}</span>
  </p>

  <div class="reveal mt-10" style="--reveal-delay:60ms">
    <VerdictPanel verdict={verdict.verdict} tone={verdict.state === 'verified' ? 'pass' : 'fail'} rows={verdict.rows} />
  </div>

  <div class="reveal mt-12 border-t border-line pt-8" style="--reveal-delay:60ms">
    <p class="note">{note.muted}</p>
    <p class="body mt-1" set:html={note.strong} />
  </div>

  <div class="reveal mt-8" style="--reveal-delay:60ms">
    <TermPanel path={terminal.label} footer={terminal.footer} label={describe(terminal.label, terminal.lines, terminal.footer)}>
      <TermLines lines={terminal.lines} />
    </TermPanel>
  </div>

  <div class="reveal mt-12" style="--reveal-delay:60ms">
    <TermPanel path={hallmark.caption} label={hallmarkLabel}>
      {hallmark.marks.map((m) => (
        <CheckRow id={m.id} name="" state={m.struck ? 'pass' : 'pending'} status={m.struck ? '✓' : ''} />
      ))}
    </TermPanel>
  </div>
</Section>
