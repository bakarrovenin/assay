---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const rows = [
  { state: 'pass', name: 'build & unit tests', status: 'passed' },
  { state: 'pass', name: 'scanner re-run', status: 'alert closed' },
] as const;

const detail = [
  'held-out case sqli_tautology_v2 still reachable',
  'patch narrows on reported payload only',
  'merge blocked by policy · appeal in thread',
];
---

{/* Fabricated. This is an illustration of the check Assay posts, not a
    screenshot of a real repository. Dark in both themes by design: it is a
    depiction of a terminal-ish surface, not part of the page chrome. */}
<div
  class={`pr-panel panel-dark reveal min-w-0 overflow-hidden ${className}`}
  role="img"
  aria-label="Illustration of a pull request checks block. Build and unit tests: passed. Scanner re-run: alert closed. Assay proof-of-fix: NOT VERIFIED, because the held-out case sqli_tautology_v2 is still reachable, the patch narrows on the reported payload only, and the merge is blocked by policy with an appeal in the thread."
>
  <div
    class="mono flex items-center gap-2 border-b border-[color:var(--color-code-line)] px-4 py-3 text-[10.5px] uppercase tracking-[0.14em] text-[color:var(--color-code-fg-2)] sm:px-5"
  >
    <span class="text-[color:var(--color-code-fg)]">Pull request #4471</span>
    <span aria-hidden="true">·</span>
    <span>autofix/cwe-89</span>
  </div>

  <ul class="mono divide-y divide-[color:var(--color-code-line)]">
    {
      rows.map((row, i) => (
        <li
          class="pr-row flex items-center gap-3 px-4 py-3.5 text-[12.5px] sm:px-5 sm:text-[13px]"
          style={`--row-delay:${i * 400}ms`}
        >
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="shrink-0 text-[color:var(--color-code-accent)]"
          >
            <path
              d="M4.5 12.6l5 5.2L19.5 6.6"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="min-w-0 flex-1 truncate text-[color:var(--color-code-fg)]">
            {row.name}
          </span>
          <span class="shrink-0 text-[color:var(--color-code-fg-2)]">{row.status}</span>
        </li>
      ))
    }

    <li
      class="pr-row pr-row-fail flex items-center gap-3 px-4 py-4 sm:px-5"
      style="--row-delay:800ms"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="shrink-0 text-[color:var(--color-code-fail)]"
      >
        <path
          d="M6 6l12 12M18 6L6 18"
          stroke="currentColor"
          stroke-width="2.8"
          stroke-linecap="round"
        />
      </svg>
      <span
        class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-[color:var(--color-code-fg)] sm:text-[14.5px]"
      >
        assay / proof-of-fix
      </span>
      <span
        class="shrink-0 text-[12px] font-medium tracking-[0.08em] text-[color:var(--color-code-fail)] sm:text-[13px]"
      >
        NOT VERIFIED
      </span>
    </li>
  </ul>

  <div
    class="pr-detail mono border-t border-[color:var(--color-code-line)] px-4 py-4 sm:px-5"
    style="--row-delay:1200ms"
  >
    <ul class="space-y-2 border-l-2 border-[color:var(--color-code-fail)] pl-4">
      {
        detail.map((line) => (
          <li class="text-[11.5px] leading-relaxed text-[color:var(--color-code-fg-2)] sm:text-[12px]">
            {line}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .pr-row,
  .pr-detail {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 380ms ease-out,
      transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--row-delay, 0ms);
  }

  /* Rows sequence off the panel entering, not off their own visibility, so
     the order is the same however the reader scrolls into it. */
  .pr-panel.is-in .pr-row,
  .pr-panel.is-in .pr-detail {
    opacity: 1;
    transform: none;
  }

  .pr-row-fail {
    background: color-mix(in srgb, var(--color-code-fail) 9%, transparent);
    box-shadow: inset 2px 0 0 var(--color-code-fail);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-row,
    .pr-detail {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
