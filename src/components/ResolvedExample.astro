---
import PatchAnatomy from './PatchAnatomy.astro';
import type { DiffLine } from './Diff.astro';
import type { TerminalLine } from './Terminal.astro';

// The counterpart to WorkedExample, same shape, same components, opposite
// outcome. The metadata column is deliberately identical: the scanner and CI
// report exactly what they reported on the patch that did not work, which is
// the entire reason the fourth role exists.

const k = (s: string) => `<span class="tok-kw">${s}</span>`;
const f = (s: string) => `<span class="tok-fn">${s}</span>`;
const c = (s: string) => `<span class="tok-com">${s}</span>`;
const s = (s: string) => `<span class="tok-str">${s}</span>`;

const Q = '&quot;';
const A = '&#39;';

const meta = [
  ['Ticket', `SEC-1042 &middot; SQL injection`],
  ['Patch by', 'agent, autonomous'],
  ['Scanner', 'finding closed'],
  ['CI', '3 / 3 passing'],
] as const;

const lines: DiffLine[] = [
  { n: 11, html: c('# app/db.py') },
  { n: 12, html: `${k('def')} ${f('get_customer')}(customer_id):` },
  {
    n: 13,
    mark: '-',
    html: `${k('if')} ${s(`${Q}OR ${A}1${A}=${A}1${A}${Q}`)} ${k('in')} customer_id:`,
  },
  {
    n: 14,
    mark: '-',
    html: `        ${k('raise')} ${f('ValueError')}(${s(`${Q}blocked: sql injection attempt${Q}`)})`,
  },
  { n: 15, mark: '-', html: `${k('if')} ${s(`${Q}${A}${Q}`)} ${k('in')} customer_id:` },
  {
    n: 16,
    mark: '-',
    html: `        customer_id = customer_id.${f('replace')}(${s(`${Q}${A}${Q}`)}, ${s(`${Q}${A}${A}${Q}`)})`,
  },
  { n: 17, html: '' },
  { n: 18, html: `${k('return')} db.${f('query')}(` },
  {
    n: 19,
    mark: '-',
    html: `${s(`f${Q}SELECT * FROM customers WHERE id = ${A}{customer_id}${A}${Q}`)}`,
  },
  {
    n: 20,
    mark: '+',
    html: `${s(`${Q}SELECT * FROM customers WHERE id = %s${Q}`)},`,
  },
  { n: 21, mark: '+', html: '[customer_id]' },
  { n: 22, html: '    )' },
];

const verdictRows = [
  ['Vuln', 'not reachable on tested paths'],
  ['CWE', '89'],
  ['Method', 'assay/1.0 · held-out'],
  ['Run', '2026-09-05T14:37Z'],
] as const;

const probe: TerminalLine[] = [
  { kind: 'cmd', html: `curl -s ${s(`${A}https://acme.internal/customers?id=42${A}`)}` },
  {
    kind: 'out',
    html: `{${Q}id${Q}:42,${Q}email${Q}:${Q}j.okafor@acme.io${Q},${Q}plan${Q}:${Q}team${Q}}  ${c('# unchanged')}`,
  },
  { kind: 'gap' },
  {
    kind: 'cmd',
    html: `curl -s ${s(`${Q}https://acme.internal/customers?id=1${A} OR ${A}1${A}=${A}1${A}${Q}`)}`,
  },
  { kind: 'out', html: '[]' },
  { kind: 'gap' },
  {
    kind: 'cmd',
    html: `curl -s ${s(`${A}https://acme.internal/customers?id=42 OR 1=1${A}`)} | head -3`,
  },
  { kind: 'out', html: '[]' },
  { kind: 'gap' },
  {
    kind: 'cmd',
    html: `curl -s ${s(`${A}https://acme.internal/customers?id=42 UNION SELECT pw,1,1 FROM users${A}`)}`,
  },
  { kind: 'out', html: '[]' },
];

const marks = [
  { id: 'AGT', title: 'agent', struck: true },
  { id: 'AUT', title: 'authority', struck: true },
  { id: 'VER', title: 'verifier', struck: true },
  { id: 'APR', title: 'approver', struck: true },
] as const;
---

<PatchAnatomy
  id="resolved-example"
  eyebrow="Anatomy of a correct fix"
  headline="This one actually fixed it."
  meta={meta}
  diff={{
    file: 'app/db.py',
    tag: 'Patched',
    added: 2,
    removed: 5,
    lines,
    footer: 'Payload never inspected, line 20',
  }}
  prose={{
    lead: 'The ticket is the same. The scanner and the build say the same thing.',
    dim: 'Only the held-out probe separates this patch from the last one.',
  }}
  verdict={{ verdict: 'Verified', state: 'verified', rows: verdictRows }}
  note={{
    muted: 'Verified is a scoped claim, not a guarantee:',
    strong: 'this hole, on the paths we tested, is shut',
  }}
  terminal={{
    label: 'Held-out probe · against the corrected build',
    lines: probe,
    footer: '0 of 3 held-out payloads returned data. Benign lookup unchanged.',
  }}
  hallmark={{ marks, caption: 'Hallmark · all four struck' }}
/>
