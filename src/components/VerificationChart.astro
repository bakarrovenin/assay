---
interface Bar {
  label: string;
  /** Bar length as a percentage, 0 to 100. */
  value: number;
  /** How the value is written out, e.g. "~50%". */
  display: string;
  note: string;
}

interface Props {
  title: string;
  caption: string;
  bars: Bar[];
  class?: string;
}

const { title, caption, bars, class: className = '' } = Astro.props;

const descId = 'chart-desc';
const summary = bars
  .map((b) => `${b.label}: ${b.display}, ${b.note}`)
  .join('. ');
---

<figure class={`chart ${className}`}>
  <figcaption class="mb-8">
    <h3 class="font-display text-[19px] font-bold leading-tight tracking-[-0.015em] lg:text-[21px]">
      {title}
    </h3>
  </figcaption>

  {/* Bars are SVG rects in a stretched viewBox: the geometry is drawn, the
      typography stays HTML so it holds the site type scale at every width. */}
  <ul class="space-y-9">
    {
      bars.map((bar, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
          <div class="mb-2.5 flex items-baseline justify-between gap-4">
            <span class="text-[14px] font-medium leading-snug">{bar.label}</span>
          </div>

          <div class="relative">
            <svg
              class="chart-svg block w-full"
              height="20"
              viewBox="0 0 100 20"
              preserveAspectRatio="none"
              role="img"
              aria-labelledby={`${descId}-${i}`}
            >
              <title id={`${descId}-${i}`}>
                {bar.label}: {bar.display}
              </title>
              <rect
                x="0"
                y="0"
                width="100"
                height="20"
                class="chart-track"
              />
              <rect
                x="0"
                y="0"
                width={bar.value}
                height="20"
                class="chart-fill"
              />
            </svg>

            <span
              class="chart-value mono absolute top-1/2 -translate-y-1/2 whitespace-nowrap pl-3 text-[15px] font-medium"
              style={`left:${bar.value}%`}
            >
              {bar.display}
            </span>
          </div>

          <p class="micro mt-2.5">{bar.note}</p>
        </li>
      ))
    }
  </ul>

  <p class="mono mt-9 border-t border-line pt-4 text-[11px] leading-relaxed text-fg-2">
    {caption}
  </p>

  {/* Text equivalent for anyone who cannot read the bars. The wrapper does
      the hiding: a bare .sr-only table still reports its intrinsic width
      to the document and pushes out a horizontal scrollbar. */}
  <div class="sr-only">
  <table>
    <caption>{title}. {summary}.</caption>
    <thead>
      <tr>
        <th scope="col">Approach</th>
        <th scope="col">Patches that were actually correct</th>
        <th scope="col">Note</th>
      </tr>
    </thead>
    <tbody>
      {
        bars.map((bar) => (
          <tr>
            <th scope="row">{bar.label}</th>
            <td>{bar.display}</td>
            <td>{bar.note}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
</figure>

<style>
  .chart-track {
    fill: var(--fg);
    opacity: 0.09;
  }

  .chart-fill {
    fill: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal.is-in .chart-fill {
    transform: scaleX(1);
  }

  .chart-value {
    color: var(--accent);
    opacity: 0;
    transition: opacity 400ms ease-out;
    transition-delay: calc(var(--reveal-delay, 0ms) + 450ms);
  }

  .reveal.is-in .chart-value {
    opacity: 1;
  }

  /* A 2% bar is a sliver; keep its label from colliding with the axis start. */
  .chart-svg {
    border-radius: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-fill {
      transform: none !important;
      transition: none !important;
    }
    .chart-value {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
