---
// The certificate. This is the primary object of the hero, not an ornament
// beside the headline.
//
// Fabricated pull request and verdict: an illustration of what Assay posts,
// not a screenshot of a real repository. The only metadata printed on it is
// metadata that is true, per the design system section 4. There is no
// certificate number, because we do not have one to print.
import { METHOD_VERSION } from '../lib/site';

// The four checks, as a punch card. A struck punch means the check was made
// and held; an unstruck one is absent rather than a different kind of
// present, which is the whole point of the device.
const checks = [
  {
    n: '01',
    name: 'Closed',
    detail: 'Reported sink removed. No suppression added.',
    failed: false,
  },
  {
    n: '02',
    name: 'Behaviour held',
    detail:
      '1 of 47 held-out payloads still injects. Patch matched the reported string, not the class.',
    failed: true,
  },
  {
    n: '03',
    name: 'No regression',
    detail: 'No new findings in the diff. Benign inputs unchanged.',
    failed: false,
  },
  {
    n: '04',
    name: 'Provenance clean',
    detail: 'Author, token scope, and blast radius within bounds.',
    failed: false,
  },
];

const label = [
  'Illustration of an Assay verdict on a pull request.',
  'A bot named coding-agent opened pull request 248, "fix: escape user input in /api/search".',
  'Semgrep 1.80.0 reports 0 findings.',
  'Assay independently checks four things.',
  ...checks.map((c) => `${c.name}: ${c.failed ? 'failed' : 'passed'}. ${c.detail}`),
  'Overall verdict: NOT VERIFIED. The alert went green. The bug did not.',
].join(' ');
---

<div class="assay-panel" role="img" aria-label={label}>
  <div class="pr">
    <div class="pr-top">
      <span class="pr-actor">coding-agent</span>
      <span class="pr-bot">bot</span>
      <span>opened a pull request</span>
      <span class="pr-num">#248</span>
    </div>
    <div class="pr-title"><span class="kw">fix:</span> escape user input in /api/search</div>
    <div class="scanner">
      <span class="dot"></span>
      <span>Semgrep 1.80.0</span>
      <span>&middot;</span>
      <b>0 findings</b>
    </div>
  </div>

  <div class="assay">
    <div class="eyebrow">
      <span class="mark">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"></polyline></svg>
      </span>
      Assay &middot; independent verification
    </div>

    <div class="checks">
      {
        checks.map((check) => (
          <div class={`check ${check.failed ? 'failed' : ''}`}>
            <span class="c-n">{check.n}</span>
            <span class={`punch ${check.failed ? 'unstruck' : 'struck'}`} aria-hidden="true">
              {!check.failed && (
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>
              )}
            </span>
            <div class="c-body">
              <div class="c-name">{check.name}</div>
              <div class="c-detail">{check.detail}</div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="verdict">
      <span class="stamp">Not verified</span>
    </div>
    <div class="kicker">The alert went green. The bug didn&rsquo;t.</div>

    <div class="foot">
      <span>Method v{METHOD_VERSION}</span>
      <span class="evidence">View evidence &rarr;</span>
    </div>
  </div>
</div>

<style>
  /* Token driven, so the panel follows the theme rather than pinning itself
     to dark. */
  .assay-panel {
    --p-ink: var(--bg);
    --p-panel: var(--bg-2);
    --p-bone: var(--fg);
    --p-graphite: var(--fg-2);
    /* 86% dipped the bot pill and PR number to 4.45:1 on paper, just under
       AA. 93% keeps the hierarchy and clears the bar in both themes. */
    --p-graphite-dim: color-mix(in srgb, var(--fg-2) 93%, var(--bg));
    --p-line: var(--line);
    --p-blue: var(--accent);
    --p-red: var(--fail);
    --p-red-dim: color-mix(in srgb, var(--fail) 76%, var(--fg));

    width: 100%;
    max-width: 600px;
    border: 1px solid var(--p-line);
    border-radius: 14px;
    background: var(--p-panel);
    color: var(--p-bone);
    overflow: hidden;
  }

  /* Incoming PR: the thing being checked */
  .pr {
    padding: 15px 20px 14px;
    border-bottom: 1px solid var(--p-line);
    background: var(--p-ink);
  }
  .pr-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--p-graphite);
    margin-bottom: 10px;
  }
  .pr-actor {
    color: var(--p-bone);
    font-weight: 500;
    /* Without this the agent name breaks mid-word on a narrow phone. */
    white-space: nowrap;
  }
  .pr-bot {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-graphite-dim);
    border: 1px solid var(--p-line);
    border-radius: 999px;
    padding: 1px 7px;
  }
  .pr-num {
    margin-left: auto;
    padding-left: 8px;
    color: var(--p-graphite-dim);
    white-space: nowrap;
  }
  .pr-title {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--p-bone);
    margin-bottom: 12px;
  }
  /* Was accent. Decoration, not meaning, so it is neutral now. */
  .pr-title .kw {
    color: var(--p-graphite);
  }
  .scanner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--p-graphite);
  }
  .scanner .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--p-graphite-dim);
  }
  .scanner b {
    color: var(--p-bone);
    font-weight: 500;
  }

  /* Assay verdict */
  .assay {
    padding: 15px 20px 16px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-graphite);
    margin-bottom: 13px;
  }
  .eyebrow .mark {
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--p-bone);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--p-bone);
    flex: none;
  }
  .eyebrow .mark svg {
    display: block;
  }

  .checks {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .check {
    display: grid;
    grid-template-columns: auto 18px 1fr;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px solid var(--p-line);
    align-items: start;
  }
  .check:first-child {
    border-top: none;
  }

  /* The card number. Metadata, so --fg-3 weight, never accent. */
  .c-n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--p-graphite-dim);
    padding-top: 2px;
  }

  /* The punch. Struck is a filled mark in the accent, which is a verified
     state and the one place accent is earned in this section. Unstruck is an
     open seat: the check was not made, so nothing was impressed into it. */
  .punch {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    flex: none;
  }
  .punch.struck {
    background: var(--p-blue);
    color: var(--p-ink);
  }
  .punch.unstruck {
    border: 1.5px dashed var(--p-red);
    background: transparent;
  }
  .punch svg {
    display: block;
  }
  .c-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-bone);
    margin-bottom: 3px;
  }
  .check.failed .c-name {
    color: var(--p-red);
  }
  .c-detail {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--p-graphite);
  }
  .check.failed .c-detail {
    color: var(--p-red-dim);
  }

  /* Verdict stamp */
  .verdict {
    display: flex;
    justify-content: center;
    padding: 20px 0 14px;
  }
  .stamp {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-red);
    border: 2.5px solid var(--p-red);
    border-radius: 6px;
    padding: 9px 20px;
    transform: rotate(-2.6deg);
  }

  .kicker {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--p-graphite);
    padding-top: 4px;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
    padding: 11px 0 0;
    border-top: 1px solid var(--p-line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--p-graphite-dim);
  }
  /* Illustrative, not a live link, so it does not take the accent. */
  .evidence {
    color: var(--p-graphite);
  }

  @media (max-width: 400px) {
    .pr,
    .assay {
      padding-inline: 16px;
    }
    .foot {
      padding-inline: 16px;
    }
  }
</style>
