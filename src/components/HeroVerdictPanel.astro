---
// Fabricated pull request and verdict. This is an illustration of what Assay
// posts, not a screenshot of a real repository.
//
// Dark in both themes, like the PR panel in the workflow section: it depicts a
// code-review surface rather than being part of the page chrome.

const checks = [
  {
    name: 'Closed',
    detail: 'Reported sink removed. No suppression added.',
    failed: false,
  },
  {
    name: 'Behaviour held',
    detail:
      '1 of 47 held-out payloads still injects. Patch matched the reported string, not the class.',
    failed: true,
  },
  {
    name: 'No regression',
    detail: 'No new findings in the diff. Benign inputs unchanged.',
    failed: false,
  },
  {
    name: 'Provenance clean',
    detail: 'Author, token scope, and blast radius within bounds.',
    failed: false,
  },
];

const label = [
  'Illustration of an Assay verdict on a pull request.',
  'A bot named coding-agent opened pull request 248, "fix: escape user input in /api/search".',
  'Semgrep 1.80.0 reports 0 findings.',
  'Assay independently checks four things.',
  ...checks.map((c) => `${c.name}: ${c.failed ? 'failed' : 'passed'}. ${c.detail}`),
  'Overall verdict: NOT VERIFIED. The alert went green. The bug did not.',
].join(' ');
---

<div class="assay-panel" role="img" aria-label={label}>
  <div class="pr">
    <div class="pr-top">
      <span class="pr-actor">coding-agent</span>
      <span class="pr-bot">bot</span>
      <span>opened a pull request</span>
      <span class="pr-num">#248</span>
    </div>
    <div class="pr-title"><span class="kw">fix:</span> escape user input in /api/search</div>
    <div class="scanner">
      <span class="dot"></span>
      <span>Semgrep 1.80.0</span>
      <span>&middot;</span>
      <b>0 findings</b>
    </div>
  </div>

  <div class="assay">
    <div class="eyebrow">
      <span class="mark">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"></polyline></svg>
      </span>
      Assay &middot; independent verification
    </div>

    <div class="checks">
      {
        checks.map((check) => (
          <div class={`check ${check.failed ? 'failed' : ''}`}>
            <span class={`glyph ${check.failed ? 'fail' : 'pass'}`}>
              {check.failed ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
              ) : (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>
              )}
            </span>
            <div>
              <div class="c-name">{check.name}</div>
              <div class="c-detail">{check.detail}</div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="verdict">
      <span class="stamp">Not verified</span>
    </div>
    <div class="kicker">The alert went green. The bug didn&rsquo;t.</div>

    <div class="foot"><span class="evidence">View evidence &rarr;</span></div>
  </div>
</div>

<style>
  /* Fixed palette: this panel stays dark whichever theme the page is in, so it
     cannot use the semantic tokens, which flip. The values are the site's own
     dark-theme colours. */
  .assay-panel {
    --p-ink: #14161a;
    --p-panel: #1a1d22;
    --p-bone: #f5f3ee;
    --p-graphite: #9aa1ab;
    --p-graphite-dim: #858c96;
    --p-line: #2a2e35;
    --p-blue: #5b9bff;
    --p-red: #e5615b;

    width: 100%;
    max-width: 520px;
    border: 1px solid var(--p-line);
    border-radius: 14px;
    background: var(--p-panel);
    color: var(--p-bone);
    overflow: hidden;
  }

  /* Incoming PR: the thing being checked */
  .pr {
    padding: 18px 20px 16px;
    border-bottom: 1px solid var(--p-line);
    background: var(--p-ink);
  }
  .pr-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--p-graphite);
    margin-bottom: 10px;
  }
  .pr-actor {
    color: var(--p-bone);
    font-weight: 500;
    /* Without this the agent name breaks mid-word on a narrow phone. */
    white-space: nowrap;
  }
  .pr-bot {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-graphite-dim);
    border: 1px solid var(--p-line);
    border-radius: 999px;
    padding: 1px 7px;
  }
  .pr-num {
    margin-left: auto;
    padding-left: 8px;
    color: var(--p-graphite-dim);
    white-space: nowrap;
  }
  .pr-title {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--p-bone);
    margin-bottom: 12px;
  }
  .pr-title .kw {
    color: var(--p-blue);
  }
  .scanner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--p-graphite);
  }
  .scanner .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--p-blue);
  }
  .scanner b {
    color: var(--p-bone);
    font-weight: 500;
  }

  /* Assay verdict */
  .assay {
    padding: 18px 20px 20px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-graphite);
    margin-bottom: 16px;
  }
  .eyebrow .mark {
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--p-bone);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--p-bone);
    flex: none;
  }
  .eyebrow .mark svg {
    display: block;
  }

  .checks {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .check {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px solid var(--p-line);
    align-items: start;
  }
  .check:first-child {
    border-top: none;
  }
  .glyph {
    margin-top: 1px;
  }
  .glyph.pass {
    color: var(--p-blue);
  }
  .glyph.fail {
    color: var(--p-red);
  }
  .glyph svg {
    display: block;
  }
  .c-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-bone);
    margin-bottom: 3px;
  }
  .check.failed .c-name {
    color: var(--p-red);
  }
  .c-detail {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--p-graphite);
  }
  .check.failed .c-detail {
    color: #dda29e;
  }

  /* Verdict stamp */
  .verdict {
    display: flex;
    justify-content: center;
    padding: 26px 0 20px;
  }
  .stamp {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-red);
    border: 2.5px solid var(--p-red);
    border-radius: 6px;
    padding: 9px 20px;
    transform: rotate(-2.6deg);
  }

  .kicker {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--p-graphite);
    padding-top: 4px;
  }
  .foot {
    display: flex;
    justify-content: flex-end;
    padding: 16px 20px 0;
  }
  .evidence {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--p-blue);
  }

  @media (max-width: 400px) {
    .pr,
    .assay {
      padding-inline: 16px;
    }
    .foot {
      padding-inline: 16px;
    }
  }
</style>
