---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import TermPanel from './system/TermPanel.astro';
import CheckRow from './system/CheckRow.astro';

// The four planes between a patch and what the code does, top to bottom,
// as one transcript. The rule where reading stops and execution starts is
// the comment line between the second and third. The layer Assay reaches
// takes the accent, not the failure colour: red means a failed verdict
// everywhere else on the site.

type Layer = {
  label: string;
  lines: [string, string];
  struck?: boolean;
};


const layers: Layer[] = [
  {
    label: 'The change',
    lines: ['the diff the agent wrote,', 'and the claim attached to it'],
  },
  {
    label: 'The scanner',
    lines: ['re-reads the same file the agent was', 'optimising against. Static. Text.'],
  },
  {
    label: 'Assay',
    lines: ['executes the patched build against', 'inputs the agent never saw'],
    struck: true,
  },
  {
    label: 'Behaviour',
    lines: ['what the code actually does.', 'Ground truth.'],
  },
];

const CAPTION = 'Everything above this line reads the patch. Below it, something runs it.';



const description = [
  'Cross-section of what observes an AI-authored change, from the surface down.',
  ...layers.map(
    (l) =>
      `${l.label}: ${l.lines.join(' ')}${l.struck ? ' This is the layer Assay reaches.' : ''}`,
  ),
  CAPTION,
].join(' ');
---

<Section id="depth-of-evidence">
  <Eyebrow class="reveal">Depth of evidence</Eyebrow>
  <h2 class="h2 reveal" style="--reveal-delay:60ms">
    Four layers sit between a patch and what the code does.
  </h2>

  {/* The drawing as a transcript: the four planes top to bottom, the rule
      between reading and running as the comment line between them, and the
      layer Assay reaches marked. */}
  <div class="reveal mt-10" style="--reveal-delay:120ms">
    <TermPanel path="Depth of evidence" label={description}>
      {layers.slice(0, 2).map((l) => (
        <CheckRow id="" name={l.label} desc={l.lines.join(' ')} state="pending" status="" />
      ))}
      <div class="ln cmt" style="padding-block:10px">{CAPTION}</div>
      {layers.slice(2).map((l) => (
        <CheckRow id="" name={l.label} desc={l.lines.join(' ')} state="pending" status={l.struck ? '\u2193' : ''} class={l.struck ? 'is-mark' : ''} />
      ))}
    </TermPanel>
  </div>
</Section>
