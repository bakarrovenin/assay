---
import Logo from './Logo.astro';
import { nav } from '../lib/site';
import ContactButton from './ContactButton.astro';
import ThemeToggle from './ThemeToggle.astro';
const { footer = false } = Astro.props;
---
{footer ? (
  <footer class="landing-footer shell">
    <a href="/" aria-label="Assay, home"><Logo /></a>
    <p>© {new Date().getFullYear()} Assay</p>
    <nav aria-label="Footer">
      {nav.map(item => <a href={item.href}>{item.label}</a>)}
      <a href="https://github.com/bakarrovenin/assay-pilot-001-evidence">GitHub ↗</a>
    </nav>
  </footer>
) : (
  <header class="landing-nav shell">
    <a href="/" aria-label="Assay, home"><Logo /></a>
    <nav aria-label="Primary">
      {nav.map(item => <a href={item.href}>{item.label}</a>)}
      <ThemeToggle />
      <ContactButton />
    </nav>
    <details class="compact-menu"><summary>Explore</summary><nav aria-label="Mobile">{nav.map(item => <a href={item.href}>{item.label}</a>)}</nav></details>
  </header>
)}
