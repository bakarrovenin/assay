---
// Theme toggle. The blocking script that sets the initial theme lives in
// BaseLayout's <head> so there is no flash; this only handles the click.
---

<button
  type="button"
  id="theme-toggle"
  class="grid h-[34px] w-[34px] place-items-center rounded-[3px] border border-line text-fg-2 transition-colors hover:text-fg"
  aria-label="Switch to dark theme"
  aria-live="polite"
>
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    data-icon="sun"
  >
    <circle cx="12" cy="12" r="4.6" stroke="currentColor" stroke-width="1.7" />
    <path
      d="M12 1.6v2.6M12 19.8v2.6M22.4 12h-2.6M4.2 12H1.6M19.35 4.65l-1.84 1.84M6.49 17.51l-1.84 1.84M19.35 19.35l-1.84-1.84M6.49 6.49L4.65 4.65"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    />
  </svg>
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    data-icon="moon"
    class="hidden"
  >
    <path
      d="M20.4 14.6A9 9 0 0 1 9.4 3.6a9 9 0 1 0 11 11Z"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linejoin="round"
    />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');

  function currentTheme(): 'light' | 'dark' {
    const set = document.documentElement.getAttribute('data-theme');
    if (set === 'light' || set === 'dark') return set;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function paint(theme: 'light' | 'dark') {
    if (!btn) return;
    const sun = btn.querySelector('[data-icon="sun"]');
    const moon = btn.querySelector('[data-icon="moon"]');
    // Show the icon for the theme you would switch INTO.
    sun?.classList.toggle('hidden', theme === 'light');
    moon?.classList.toggle('hidden', theme === 'dark');
    btn.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  }

  paint(currentTheme());

  btn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('assay-theme', next);
    } catch {
      /* storage blocked; the choice just will not persist */
    }
    paint(next);
  });
</script>
