---
// The assay hallmark. On silver, four marks are struck into the metal, one
// per party that vouched for it. Here: the agent that wrote the change, the
// authority it held, the verifier, and the human approver. A mark that was
// never struck is the whole point of the device, so unstruck reads as
// absent rather than as a different style of present.

export type Mark = {
  /** Three letters, e.g. AGT. */
  id: string;
  /** Expanded for screen readers, e.g. "agent". */
  title: string;
  struck: boolean;
  /**
   * What this punch stands for, printed under it. Supplying a gloss on any
   * mark switches the device from the inline strip to a block, where the
   * marks are the anchor of a section rather than a footnote to one.
   */
  gloss?: string;
};

interface Props {
  marks: readonly Mark[];
  caption: string;
  class?: string;
}

const { marks, caption, class: className = '' } = Astro.props;

const glossed = marks.some((m) => m.gloss);

const description = `Hallmark. ${marks
  .map((m) => `${m.title} ${m.struck ? 'struck' : 'not struck'}`)
  .join(', ')}.`;
---

{
  glossed ? (
    <div class={`hm hm-block ${className}`} role="img" aria-label={description}>
      <div class="hm-grid">
        {marks.map((mark) => (
          <div class="hm-cell">
            <span class={`hm-mark ${mark.struck ? 'is-struck' : ''}`}>{mark.id}</span>
            <span class="hm-gloss">{mark.gloss}</span>
          </div>
        ))}
      </div>

      <p class="hm-caption hm-caption-block">{caption}</p>
    </div>
  ) : (
    <div class={`hm ${className}`} role="img" aria-label={description}>
      <div class="hm-marks">
        {marks.map((mark) => (
          <span class={`hm-mark ${mark.struck ? 'is-struck' : ''}`}>{mark.id}</span>
        ))}
      </div>

      <span class="hm-rule" aria-hidden="true"></span>

      <span class="hm-caption">{caption}</span>
    </div>
  )
}

<style>
  .hm {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Shared borders, like punches struck side by side on one plate. */
  .hm-marks {
    display: flex;
    flex: none;
  }

  .hm-mark {
    display: grid;
    place-items: center;
    min-width: 58px;
    padding: 11px 12px;
    border: 1px solid var(--line);
    margin-left: -1px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--fg-2) 55%, transparent);
  }

  .hm-mark:first-child {
    margin-left: 0;
  }

  .hm-mark.is-struck {
    color: var(--fg-2);
  }

  /* Large block form, opted into with .hm-lg. The punches become the anchor
     of a section rather than a device inside one. Scoped rather than applied
     to every block hallmark, because the pilot-001 post uses the block form
     too and is not part of this stage. */
  .hm.hm-lg .hm-cell {
    gap: 16px;
    padding: 28px 20px 26px;
  }

  .hm.hm-lg .hm-mark {
    min-width: 0;
    width: 100%;
    padding: 22px 12px;
    font-size: clamp(20px, 2.6vw, 30px);
    letter-spacing: 0.16em;
    font-weight: 500;
  }

  .hm.hm-lg .hm-mark.is-struck {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .hm.hm-lg .hm-mark:not(.is-struck) {
    color: var(--fg-3);
    background: transparent;
    /* An empty seat has to read as a seat, or the unstruck punch looks like
       quiet text rather than an absent mark. */
    border-style: dashed;
    border-color: color-mix(in srgb, var(--fg-3) 55%, transparent);
  }

  .hm-rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--line);
    /* Below the caption breakpoint the rule would sit alone on its row. */
    min-width: 0;
  }

  .hm-caption {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  /* On a phone the caption cannot share the row with four marks. */
  @media (max-width: 700px) {
    .hm {
      flex-wrap: wrap;
      gap: 14px;
    }

    .hm-rule {
      display: none;
    }

    .hm-caption {
      flex-basis: 100%;
    }
  }

  @media (max-width: 380px) {
    .hm-mark {
      min-width: 0;
      flex: 1 1 0;
      padding-inline: 6px;
      font-size: 11px;
    }

    .hm-marks {
      width: 100%;
    }
  }
  /* --- block variant: the marks carry a section rather than close one --- */
  .hm-block {
    display: block;
  }

  .hm-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 720px) {
    .hm-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hm-cell {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 18px 20px;
    border: 1px solid var(--line);
    /* Shared edges, like punches struck side by side on one plate. */
    margin-left: -1px;
    margin-top: -1px;
  }

  .hm-block .hm-mark {
    min-width: 0;
    padding: 0;
    border: 0;
    margin-left: 0;
    display: block;
    text-align: left;
    font-size: 15px;
    letter-spacing: 0.18em;
    /* Carrying the section, so the punch outranks its gloss. In the strip
       the marks are a footnote and stay at --fg-2. */
    color: color-mix(in srgb, var(--fg-2) 55%, transparent);
  }

  .hm-block .hm-mark.is-struck {
    color: var(--fg);
  }

  .hm-gloss {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--fg-2);
  }

  .hm-caption-block {
    margin-top: 14px;
  }
</style>
