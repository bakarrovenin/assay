---
import { INDEX_SIGNUP_ENDPOINT } from '../lib/site';

// Same Loops endpoint as the Index signup, told apart by the userGroup the
// submit sends ("verify-pr" here, "index" there). The action attribute is kept
// as a no-JS fallback; the script below intercepts and posts it as fetch.
---

<dialog id="verify-modal" class="verify-modal" aria-labelledby="verify-modal-title">
  <form
    method="post"
    action={INDEX_SIGNUP_ENDPOINT || undefined}
    data-verify-form
    class="verify-modal-panel"
  >
    <input type="hidden" name="source" value="verify-pr" />

    <div class="flex items-start justify-between gap-6">
      <h2 id="verify-modal-title" class="h3">Join the waitlist</h2>
      <button
        type="button"
        class="icon-btn"
        data-verify-close
        aria-label="Close"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>

    <p class="body mt-3 text-fg-2" data-verify-lede>
      A verifier that runs on every pull request, on your own repositories, is in
      development. Leave an address and we will tell you when it is ready.
    </p>

    <label for="verify-email" class="hd mt-7 block">
      Get an install link when your slot opens
    </label>

    <div class="mt-3.5 flex flex-col gap-2.5 xs:flex-row">
      <input
        id="verify-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@company.com"
        class="input flex-1"
      />
      <button type="submit" class="btn btn-primary shrink-0">Notify me</button>
    </div>

    <p class="disc mt-3" data-verify-status role="status">
      One message when your slot opens. Nothing else, ever.
    </p>
  </form>
</dialog>

<style>
  .verify-modal {
    padding: 0;
    border: 0;
    background: transparent;
    /* The UA centres a modal dialog with margin:auto, but the Tailwind reset
       zeroes margins on every element, which pins it to the top left. */
    margin: auto;
    max-width: min(520px, calc(100vw - 32px));
    width: 100%;
    color: var(--fg);
  }

  .verify-modal::backdrop {
    background: rgba(10, 12, 15, 0.62);
    backdrop-filter: blur(3px);
  }

  .verify-modal-panel {
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: var(--r-3);
    box-shadow: var(--shadow-term);
    padding: 28px;
    text-align: left;
  }

  @media (min-width: 30rem) {
    .verify-modal-panel { padding: 32px; }
  }

</style>

<script>
  import { submitSignup } from '../lib/signup';

  const modal = document.querySelector<HTMLDialogElement>('#verify-modal');
  const form = modal?.querySelector<HTMLFormElement>('[data-verify-form]');
  const status = modal?.querySelector<HTMLElement>('[data-verify-status]');
  const input = modal?.querySelector<HTMLInputElement>('#verify-email');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const title = modal?.querySelector<HTMLElement>('#verify-modal-title');
  const lede = modal?.querySelector<HTMLElement>('[data-verify-lede]');
  const source = form?.querySelector<HTMLInputElement>('input[name="source"]');

  const RESTING = status?.textContent ?? '';
  // Defaults are the pull-request waitlist. A trigger can override the group and
  // copy so the same modal serves more than one waitlist (e.g. the benchmark).
  const DEFAULT_GROUP = source?.value ?? 'verify-pr';
  const DEFAULT_TITLE = title?.textContent ?? 'Join the waitlist';
  const DEFAULT_LEDE = lede?.textContent ?? '';
  let currentGroup = DEFAULT_GROUP;

  // Every waitlist control across the site opts in with data-verify-cta rather
  // than wiring its own handler. Optional data-verify-group / -title / -lede let
  // a control point the same modal at a different Loops segment with its own
  // words.
  document.querySelectorAll<HTMLElement>('[data-verify-cta]').forEach((el) =>
    el.addEventListener('click', (event) => {
      event.preventDefault();
      currentGroup = el.dataset.verifyGroup || DEFAULT_GROUP;
      if (source) source.value = currentGroup;
      if (title) title.textContent = el.dataset.verifyTitle || DEFAULT_TITLE;
      if (lede) lede.textContent = el.dataset.verifyLede || DEFAULT_LEDE;
      if (status) status.textContent = RESTING;
      modal?.showModal();
      input?.focus();
    }),
  );

  modal?.querySelector('[data-verify-close]')?.addEventListener('click', () =>
    modal.close(),
  );

  // Click outside the panel closes. The dialog element itself fills the
  // backdrop area, so a click landing on it and not on the form is outside.
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });

  form?.addEventListener('submit', async (event) => {
    // Handled here rather than by a native POST, so the modal stays open and
    // reports the result in place instead of navigating away.
    event.preventDefault();

    const email = input?.value.trim();
    if (!email) return;

    const label = button?.textContent ?? 'Notify me';
    if (button) {
      button.disabled = true;
      button.textContent = 'Please wait';
    }
    if (status) status.textContent = 'Sending, please wait.';

    const result = await submitSignup(email, currentGroup);

    if (button) {
      button.disabled = false;
      button.textContent = label;
    }

    if (result.ok) {
      form.reset();
      if (status) {
        status.textContent = 'You are on the list. We will email you when it opens.';
      }
      return;
    }

    if (status) status.textContent = result.message;
  });

  input?.addEventListener('input', () => {
    if (status && status.textContent !== RESTING) status.textContent = RESTING;
  });
</script>
