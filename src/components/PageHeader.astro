---
interface Props {
  eyebrow: string;
  title: string;
  /**
   * A gloss set directly under the title, before the lede. Used where the
   * title is a motto and the line beneath it is the translation.
   */
  titleNote?: string;
  lede: string;
  subLede?: string;
}

const { eyebrow, title, titleNote, lede, subLede } = Astro.props;
---

<header class="section-hero rule-b">
  <div class="shell">
    <p class="hd reveal">{eyebrow}</p>

    <h1 class="h1 reveal mt-6" style="--reveal-delay:60ms">{title}</h1>

    {titleNote && <p class="note reveal mt-5" style="--reveal-delay:90ms">{titleNote}</p>}

    <p class="lede reveal mt-8" style="--reveal-delay:120ms">{lede}</p>

    {
      subLede && (
        <p class="body reveal mt-5 text-fg-2" style="--reveal-delay:180ms;max-width:58ch">
          {subLede}
        </p>
      )
    }
  </div>
</header>
